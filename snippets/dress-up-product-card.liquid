{% comment %}
  Selectable product card for the "Pick - Pair - Play!" builder.

  The card is the product image: picking it rings it in the accent colour and
  reveals its own controls underneath. Those controls are built from the
  product's real options, and the card ships its full variant list as JSON so
  the builder can resolve the exact variant a customer configured without a
  second request.

  Accepts:
  - product:       Shopify product object
  - section:       parent section object
  - block:         parent step block object
  - index:         forloop index within the step
  - show_options:  boolean, render the option controls (size, colour, ...)
  - option_names:  comma separated option names to show; blank shows them all
  - show_quantity: boolean, render the quantity stepper
  - loading:       image loading strategy
{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign card_id = 'DressCard-' | append: section.id | append: '-' | append: block.id | append: '-' | append: index
-%}

{%- capture variants_json -%}
  [
  {%- for product_variant in product.variants -%}
    {
      "id": {{ product_variant.id }},
      "price": {{ product_variant.price }},
      "available": {{ product_variant.available }},
      "options": {{ product_variant.options | json }},
      "title": {{ product_variant.title | json }},
      "image": {% if product_variant.featured_media %}{{ product_variant.featured_media | image_url: width: 800 | json }}{% else %}null{% endif %}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  ]
{%- endcapture -%}

<article
  class="ds-card{% unless product.available %} ds-card--soldout{% endunless %}"
  data-dress-card
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-selected-options="{{ variant.options | json | escape }}"
  data-default-image="{{ product.featured_media | image_url: width: 800 | escape }}"
>
  <button
    class="ds-card__pick"
    type="button"
    id="{{ card_id }}"
    aria-pressed="false"
    data-dress-pick
    {% unless product.available %}disabled{% endunless %}
  >
    <span class="visually-hidden">
      {{- product.title }} — {{ variant.price | money }}
      {%- unless product.available %} ({{ 'products.product.sold_out' | t }}){% endunless -%}
    </span>

    {%- if product.featured_media != blank -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag:
          class: 'ds-card__image',
          widths: '160, 220, 300, 400, 560, 800',
          sizes: '(min-width: 990px) 260px, (min-width: 750px) 30vw, 45vw',
          loading: loading
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'ds-card__image ds-card__image--placeholder' }}
    {%- endif -%}

    <span class="ds-card__check" aria-hidden="true">
      <svg viewBox="0 0 12 12" focusable="false">
        <path d="m2 6 2.5 2.5L10 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>

    {%- unless product.available -%}
      <span class="ds-card__flag">{{ 'products.product.sold_out' | t }}</span>
    {%- endunless -%}
  </button>

  {%- comment -%}
    Controls belong to the chosen card, but keep their space so a row of cards
    never jumps when a selection changes.
  {%- endcomment -%}
  <div class="ds-card__controls">
    {%- comment -%}
      Spaces are stripped from both sides of the comparison, so "Collar Size"
      matches and a merchant can write "Size, Colour" either way.
    {%- endcomment -%}
    {%- assign wanted_options = option_names | downcase | replace: ' ', '' | split: ',' -%}

    {%- capture option_controls -%}
      {%- if show_options -%}
        {%- for option in product.options_with_values -%}
          {%- if option.values.size < 2 -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign option_name = option.name | downcase
            if wanted_options.size > 0
              assign option_key = option.name | downcase | replace: ' ', ''
              unless wanted_options contains option_key
                continue
              endunless
            endif
            assign is_swatch = false
            if option_name contains 'color' or option_name contains 'colour'
              assign is_swatch = true
            endif
          -%}
          <div class="ds-card__values" role="group" aria-label="{{ product.title | escape }} — {{ option.name | escape }}">
            {%- for value in option.values -%}
              {%- liquid
                assign swatch_style = ''
                if is_swatch
                  if value.swatch.color
                    assign swatch_style = 'background-color: rgb(' | append: value.swatch.color.rgb | append: ');'
                  elsif value.swatch.image
                    assign swatch_url = value.swatch.image | image_url: width: 60
                    assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                  endif
                endif
              -%}
              <button
                class="ds-card__value{% if swatch_style != blank %} ds-card__value--swatch{% endif %}"
                type="button"
                aria-pressed="false"
                data-dress-option
                data-option-index="{{ forloop.parentloop.index0 }}"
                data-value="{{ value | escape }}"
                {% if swatch_style != blank %}style="{{ swatch_style }}"{% endif %}
              >
                <span {% if swatch_style != blank %}class="visually-hidden"{% endif %}>{{ value }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- comment -%}
      Only wrap real controls: an empty options box would take the place of the
      quantity stepper as the row's only child, and stop it centring.
    {%- endcomment -%}
    {%- if option_controls contains 'data-dress-option' -%}
      <div class="ds-card__options">{{ option_controls }}</div>
    {%- endif -%}

    {%- if show_quantity and product.available -%}
      <div class="ds-card__quantity" data-dress-quantity>
        <button
          class="ds-card__quantity-button"
          type="button"
          data-dress-quantity-change="-1"
          aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
        >&minus;</button>
        <output class="ds-card__quantity-value" data-dress-quantity-value aria-live="polite">1</output>
        <button
          class="ds-card__quantity-button"
          type="button"
          data-dress-quantity-change="1"
          aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
        >+</button>
      </div>
    {%- endif -%}
  </div>

  <script type="application/json" data-dress-variants>{{ variants_json }}</script>
</article>
