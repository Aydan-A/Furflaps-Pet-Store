{% comment %}
  Selectable product card for the "Pick - Pair - Play!" builder.

  A radio input + label keeps selection single-choice and keyboard accessible
  without custom JavaScript. All product data is read from Shopify.

  Accepts:
  - product: Shopify product object
  - section: parent section object
  - block: parent step block object
  - index: forloop index within the step
  - show_quantity: boolean, render the quantity stepper on the selected card
  - loading: image loading strategy
{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign input_id = 'DressStep-' | append: section.id | append: '-' | append: block.id | append: '-' | append: index
-%}

<div class="dress-steps-card{% unless product.available %} dress-steps-card--unavailable{% endunless %}">
  <input
    class="dress-steps-card__input visually-hidden"
    type="radio"
    id="{{ input_id }}"
    name="dress-step-{{ section.id }}-{{ block.id }}"
    value="{{ variant.id }}"
    data-dress-product
    data-price="{{ variant.price }}"
    data-title="{{ product.title | escape }}"
    data-image="{{ product.featured_media | image_url: width: 80 }}"
    {% unless product.available %}disabled{% endunless %}
  >
  <label class="dress-steps-card__label" for="{{ input_id }}">
    <span class="visually-hidden">
      {{- product.title }} — {{ variant.price | money }}
      {%- unless product.available %} ({{ 'products.product.sold_out' | t }}){% endunless -%}
    </span>

    {%- if product.featured_media != blank -%}
      {{
        product.featured_media
        | image_url: width: 900
        | image_tag:
          class: 'dress-steps-card__image',
          widths: '180, 240, 320, 420, 560, 720, 900',
          sizes: '(min-width: 1200px) 260px, (min-width: 750px) 23vw, 72vw',
          loading: loading
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'dress-steps-card__image dress-steps-card__placeholder' }}
    {%- endif -%}

    <span class="dress-steps-card__check" aria-hidden="true">
      <svg viewBox="0 0 12 12" focusable="false">
        <path d="m2 6 2.5 2.5L10 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>

    {%- unless product.available -%}
      <span class="dress-steps-card__sold-out">{{ 'products.product.sold_out' | t }}</span>
    {%- endunless -%}
  </label>

  {%- if show_quantity and product.available -%}
    <div class="dress-steps-card__quantity" data-dress-quantity>
      <button
        class="dress-steps-card__quantity-button"
        type="button"
        data-dress-quantity-change="1"
        aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
      >+</button>
      <output
        class="dress-steps-card__quantity-value"
        data-dress-quantity-value
        aria-live="polite"
        aria-label="{{ 'products.product.quantity.label' | t | escape }}"
      >1</output>
      <button
        class="dress-steps-card__quantity-button"
        type="button"
        data-dress-quantity-change="-1"
        aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
      >&minus;</button>
    </div>
  {%- endif -%}
</div>
