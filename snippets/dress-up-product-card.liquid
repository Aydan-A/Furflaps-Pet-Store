{% comment %}
  Selectable product card for the "Pick - Pair - Play!" section.

  Renders a radio input + label so selection is single-choice, keyboard
  accessible (arrow keys) and stateful without any custom JavaScript.

  Accepts:
  - product: Shopify product object
  - section: parent section object
  - block: parent step block object
  - index: forloop index within the step
  - checked: boolean, whether this card starts selected
  - loading: image loading strategy
{% endcomment %}

{%- liquid
  assign input_id = 'DressStep-' | append: section.id | append: '-' | append: block.id | append: '-' | append: index
-%}

<div class="dress-steps-card">
  <input
    class="dress-steps-card__input visually-hidden"
    type="radio"
    id="{{ input_id }}"
    name="dress-step-{{ section.id }}-{{ block.id }}"
    value="{{ product.id }}"
    data-price="{{ product.price | money }}"
    data-url="{{ product.url }}"
    data-title="{{ product.title | escape }}"
    {% if checked %}checked{% endif %}
  >
  <label class="dress-steps-card__label" for="{{ input_id }}">
    <span class="visually-hidden">{{ product.title | escape }} — {{ product.price | money }}</span>

    {%- if product.featured_media != blank -%}
      {{
        product.featured_media
        | image_url: width: 900
        | image_tag:
          class: 'dress-steps-card__image',
          widths: '180, 240, 320, 420, 560, 720, 900',
          sizes: '(min-width: 1200px) 260px, (min-width: 750px) 23vw, 72vw',
          loading: loading
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'dress-steps-card__image dress-steps-card__placeholder' }}
    {%- endif -%}

    <span class="dress-steps-card__check" aria-hidden="true">
      <svg viewBox="0 0 12 12" focusable="false">
        <path d="m2 6 2.5 2.5L10 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </label>
</div>
