{% comment %}
  Product card used by the Hot this week section.

  Accepts:
  - block: Block object (type "product_card")
  - section: Section object
  - lazy_load: Boolean
{% endcomment %}

{%- liquid
  assign product = block.settings.product
  assign card_title = block.settings.custom_title | default: product.title
  assign card_url = block.settings.custom_link | default: product.url
  assign is_clickable = card_url != blank

  assign color_option_name = section.settings.color_option_name | downcase
  assign color_value = blank
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == color_option_name
      assign color_value = option.values.first
      break
    endif
  endfor

  assign discount_final = blank
  if block.settings.show_discount
    assign discount_final = block.settings.discount_text
    if discount_final == blank and block.settings.custom_price == blank and product.compare_at_price > product.price
      assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
      assign discount_final = discount_pct | append: '% off'
    endif
  endif
-%}

<article class="hot-card">
  {%- if is_clickable -%}
    <a class="hot-card__media" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
  {%- else -%}
    <div class="hot-card__media">
  {%- endif -%}
    <div class="hot-card__badges">
      {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
        <span class="hot-card__badge hot-card__badge--custom">{{ block.settings.badge_text | escape }}</span>
      {%- endif -%}
      {%- if discount_final != blank -%}
        <span class="hot-card__badge hot-card__badge--sale">{{ discount_final | escape }}</span>
      {%- endif -%}
      {%- if product != blank and product.available == false -%}
        <span class="hot-card__badge hot-card__badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>

    {%- if block.settings.custom_image != blank -%}
      {{
        block.settings.custom_image
        | image_url: width: 900
        | image_tag:
          class: 'hot-card__image hot-card__image--primary',
          widths: '240, 360, 480, 640, 750, 900',
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 38vw, 72vw',
          loading: lazy_load
      }}
    {%- elsif product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 900
        | image_tag:
          class: 'hot-card__image hot-card__image--primary',
          widths: '240, 360, 480, 640, 750, 900',
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 38vw, 72vw',
          loading: lazy_load
      }}
      {%- if section.settings.show_secondary_image and product.media[1].media_type == 'image' -%}
        {{
          product.media[1]
          | image_url: width: 900
          | image_tag:
            class: 'hot-card__image hot-card__image--secondary',
            widths: '240, 360, 480, 640, 750, 900',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 38vw, 72vw',
            loading: 'lazy'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'hot-card__placeholder' }}
    {%- endif -%}
  {%- if is_clickable -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}

  <div class="hot-card__details">
    <h3 class="hot-card__title">
      {%- if is_clickable -%}
        <a href="{{ card_url }}">{{ card_title | escape }}</a>
      {%- else -%}
        {{ card_title | escape }}
      {%- endif -%}
    </h3>

    {%- if block.settings.description != blank -%}
      <p class="hot-card__description">{{ block.settings.description | escape }}</p>
    {%- endif -%}

    {%- if block.settings.custom_price != blank -%}
      <div class="price hot-card__price{% if block.settings.custom_compare_price != blank %} price--on-sale{% endif %}">
        <div class="price__container">
          {%- if block.settings.custom_compare_price != blank -%}
            <span>
              <s class="price-item price-item--regular">{{ block.settings.custom_compare_price }}</s>
            </span>
          {%- endif -%}
          <span class="price-item price-item--sale price-item--last">{{ block.settings.custom_price }}</span>
        </div>
      </div>
    {%- elsif product != blank -%}
      {% render 'price', product: product, price_class: 'hot-card__price', show_compare_at_price: true %}
    {%- endif -%}

    {%- if section.settings.show_color_swatch and color_value != blank and color_value.swatch != blank -%}
      <span class="hot-card__swatch" title="{{ color_value | escape }}">
        <span class="visually-hidden">{{ color_value }}</span>
        {% render 'swatch', swatch: color_value.swatch, shape: 'square' %}
      </span>
    {%- endif -%}
  </div>
</article>
