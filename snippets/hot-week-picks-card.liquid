{% comment %}
  Product card used by the Hot this week section.

  Accepts:
  - product: Product object
  - section: Section object
  - tab_key: String, keeps radio group names unique when a product is in both tabs
  - lazy_load: Boolean
{% endcomment %}

{%- liquid
  assign custom_badge = blank
  if section.settings.show_metafield_badge
    assign custom_badge = product.metafields.custom.card_badge.value
  endif

  assign discount_final = blank
  if section.settings.show_discount and product.compare_at_price > product.price
    assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
    assign discount_final = discount_pct | append: '% off'
  endif

  # The card's width is set by the column count for the breakpoint, so the
  # sizes hint is derived from the same settings rather than a fixed guess.
  # A single full-width card was being told it was 72vw, which loaded an image
  # too small for it on a phone.
  assign hot_columns_mobile = section.settings.columns_mobile | plus: 0
  if hot_columns_mobile < 1
    assign hot_columns_mobile = 1
  endif
  assign hot_columns_tablet = section.settings.columns_tablet | plus: 0
  if hot_columns_tablet < 1
    assign hot_columns_tablet = 1
  endif
  assign hot_mobile_vw = 90 | divided_by: hot_columns_mobile
  assign hot_tablet_vw = 92 | divided_by: hot_columns_tablet
  capture hot_card_sizes
    echo '(min-width: 990px) 25vw, (min-width: 750px) '
    echo hot_tablet_vw
    echo 'vw, '
    echo hot_mobile_vw
    echo 'vw'
  endcapture

  assign money_price = blank
  assign money_compare_price = blank
  if settings.currency_code_enabled
    assign money_price = product.price | money_with_currency
  else
    assign money_price = product.price | money
  endif
  if product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
  if product.compare_at_price > product.price and product.price_varies == false and product.compare_at_price_varies == false
    if settings.currency_code_enabled
      assign money_compare_price = product.compare_at_price | money_with_currency
    else
      assign money_compare_price = product.compare_at_price | money
    endif
  endif
-%}

<div class="hot-week-picks__card">
  <div class="hot-card__media-wrap">
    <a class="hot-card__media" href="{{ product.url }}" data-card-link aria-label="{{ product.title | escape }}">
      {%- if custom_badge != blank -%}
        <span class="hot-card__badge">{{ custom_badge | escape }}</span>
      {%- endif -%}

      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            class: 'hot-card__image',
            widths: '240, 360, 480, 640, 750, 900',
            sizes: hot_card_sizes,
            loading: lazy_load
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'hot-card__placeholder' }}
      {%- endif -%}
    </a>

    {%- if section.settings.show_add_to_cart and product != blank -%}
      {%- if product.available == false -%}
        <span class="hot-card__cart hot-card__cart--disabled" aria-hidden="true" title="{{ 'products.product.sold_out' | t }}">
          {{- 'icon-cart.svg' | inline_asset_content -}}
        </span>
      {%- elsif product.variants.size > 1 -%}
        {%- comment -%}
          Multiple variants need an option choice, so send shoppers to the product page
          instead of guessing a variant.
        {%- endcomment -%}
        <a
          class="hot-card__cart"
          href="{{ product.url }}"
          data-card-link
          aria-label="{{ 'products.product.choose_options' | t }} — {{ product.title | escape }}"
        >
          {{- 'icon-cart.svg' | inline_asset_content -}}
        </a>
      {%- else -%}
        {%- assign hot_form_id = 'HotAtc-' | append: section.id | append: '-' | append: product.id -%}
        <product-form class="hot-card__cart-form" data-section-id="{{ section.id }}">
          {%- form 'product', product, id: hot_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
              class="product-variant-id"
            >
            <button
              id="{{ hot_form_id }}-submit"
              class="hot-card__cart"
              type="submit"
              name="add"
              aria-haspopup="dialog"
              aria-label="{{ 'products.product.add_to_cart' | t }} — {{ product.title | escape }}"
              data-sold-out-message="true"
            >
              <span class="hot-card__cart-icon">
                {{- 'icon-cart.svg' | inline_asset_content -}}
              </span>
              <span class="sold-out-message hidden">
                {{ 'products.product.sold_out' | t }}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
          {%- endform -%}
        </product-form>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="hot-card__info">
    <h3 class="hot-card__title">
      <a class="hot-card__link" href="{{ product.url }}" data-card-link>{{ product.title | escape }}</a>
    </h3>

    {%- comment -%}
      Size tag: the value of the first available variant's size option. The
      wanted name matches anywhere in the option name, so "Size" also finds
      "Collar Size". Products without a size option show no tag.
    {%- endcomment -%}
    {%- unless section.settings.show_size_tag == false -%}
      {%- liquid
        assign size_value = blank
        assign size_wanted = section.settings.size_option_name | default: 'Size' | downcase | replace: ' ', ''
        assign size_variant = product.selected_or_first_available_variant
        for option in product.options_with_values
          assign size_key = option.name | downcase | replace: ' ', ''
          if size_key contains size_wanted
            assign size_value = size_variant.options[forloop.index0]
            assign size_value = size_value | split: '(' | first | strip
            break
          endif
        endfor
      -%}
      {%- if size_value != blank -%}
        <span class="hot-card__size">{{ size_value | escape }}</span>
      {%- endif -%}
    {%- endunless -%}

    {%- if section.settings.show_swatches -%}
      {%- assign color_group_id = 'HotColor-' | append: section.id | append: '-' | append: tab_key | append: '-' | append: product.id -%}
      {% render 'hot-card-color-options',
        product: product,
        option_name: section.settings.color_option_name,
        max_swatches: section.settings.swatches_to_show,
        group_id: color_group_id
      %}
    {%- endif -%}

    <div class="hot-card__prices">
      <span class="hot-card__price">{{ money_price }}</span>
      {%- if money_compare_price != blank -%}
        <s class="hot-card__price-was">
          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
          {{ money_compare_price }}
        </s>
      {%- endif -%}
      {%- if discount_final != blank -%}
        <span class="hot-card__discount">{{ discount_final | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
