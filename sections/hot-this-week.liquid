{{ 'hot-this-week.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hot-this-week.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign first_tab_active = true
  if section.settings.default_tab == 'new_arrivals'
    assign first_tab_active = false
  endif

  assign best_count = 0
  assign new_count = 0
  for block in section.blocks
    if block.settings.tab == 'best_sellers' or block.settings.tab == 'both'
      assign best_count = best_count | plus: 1
    endif
    if block.settings.tab == 'new_arrivals' or block.settings.tab == 'both'
      assign new_count = new_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --hot-section-background: {{ section.settings.background_color }};
    --hot-text-color: {{ section.settings.text_color }};
    --hot-image-background: {{ section.settings.image_background }};
    --hot-tab-active-background: {{ section.settings.tab_active_background }};
    --hot-tab-active-text: {{ section.settings.tab_active_text }};
    --hot-tab-text: {{ section.settings.tab_text }};
    --hot-description-color: {{ section.settings.description_color }};
    --hot-description-size: {{ section.settings.description_size }}px;
    --hot-description-lines: {{ section.settings.description_lines }};
    --hot-compare-price-color: {{ section.settings.compare_price_color }};
    --hot-discount-pill-background: {{ section.settings.discount_pill_background }};
    --hot-discount-pill-text: {{ section.settings.discount_pill_text }};
    --hot-badge-background: {{ section.settings.badge_background }};
    --hot-badge-text: {{ section.settings.badge_text_color }};
    --hot-padding-top: {{ section.settings.padding_top }}px;
    --hot-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hot-padding-inline: {{ section.settings.padding_inline }}px;
    --hot-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --hot-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --hot-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    --hot-header-spacing: {{ section.settings.header_spacing }}px;
    --hot-card-gap: {{ section.settings.card_gap }}px;
    --hot-card-radius: {{ section.settings.card_radius }}px;
    --hot-card-content-spacing: {{ section.settings.card_content_spacing }}px;
    --hot-badge-offset: {{ section.settings.badge_offset }}px;
    --hot-columns: {{ section.settings.columns_desktop }};
    --hot-columns-tablet: {{ section.settings.columns_tablet }};
    --hot-columns-mobile: {{ section.settings.columns_mobile }};
    --hot-image-ratio: {{ section.settings.image_ratio }};
    --hot-image-fit: {{ section.settings.image_fit }};
    --hot-heading-font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --hot-heading-font-style: {{ section.settings.heading_font.style }};
    --hot-heading-size: {{ section.settings.heading_size }}px;
    --hot-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --hot-heading-weight: {{ section.settings.heading_weight }};
    --hot-heading-letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 10.0 }}px;
    --hot-product-title-size: {{ section.settings.product_title_size }}px;
    --hot-price-size: {{ section.settings.price_size }}px;
    --hot-tab-font-size: {{ section.settings.tab_font_size }}px;
    --hot-tab-height: {{ section.settings.tab_height }}px;
    --hot-tab-padding: {{ section.settings.tab_padding }}px;
    --hot-tab-radius: {{ section.settings.tab_radius }}px;
    --hot-tab-gap: {{ section.settings.tab_gap }}px;
  }
{%- endstyle -%}

<hot-this-week class="hot-this-week">
  <div class="hot-this-week__inner">
    <div class="hot-this-week__header">
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="hot-this-week__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.show_tabs -%}
        <div class="hot-this-week__tabs" role="tablist" aria-label="{{ section.settings.tabs_accessibility_label | escape }}">
          <button
            class="hot-this-week__tab"
            id="HotTab-{{ section.id }}-best"
            type="button"
            role="tab"
            aria-selected="{% if first_tab_active %}true{% else %}false{% endif %}"
            aria-controls="HotPanel-{{ section.id }}-best"
            tabindex="{% if first_tab_active %}0{% else %}-1{% endif %}"
          >
            {{ section.settings.best_sellers_label | escape }}
          </button>
          <button
            class="hot-this-week__tab"
            id="HotTab-{{ section.id }}-new"
            type="button"
            role="tab"
            aria-selected="{% unless first_tab_active %}true{% else %}false{% endunless %}"
            aria-controls="HotPanel-{{ section.id }}-new"
            tabindex="{% unless first_tab_active %}0{% else %}-1{% endunless %}"
          >
            {{ section.settings.new_arrivals_label | escape }}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- for tab_index in (1..2) -%}
      {%- liquid
        if tab_index == 1
          assign tab_key = 'best'
          assign tab_value = 'best_sellers'
          assign tab_count = best_count
          assign panel_is_active = first_tab_active
        else
          assign tab_key = 'new'
          assign tab_value = 'new_arrivals'
          assign tab_count = new_count
          assign panel_is_active = false
          unless first_tab_active
            assign panel_is_active = true
          endunless
        endif
      -%}
      <div
        class="hot-this-week__panel"
        id="HotPanel-{{ section.id }}-{{ tab_key }}"
        role="tabpanel"
        aria-labelledby="HotTab-{{ section.id }}-{{ tab_key }}"
        tabindex="0"
        {% unless panel_is_active or section.settings.show_tabs == false %}hidden{% endunless %}
      >
        {%- if tab_count > 0 -%}
          <ul class="hot-this-week__products" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'product_card' -%}
                {%- if block.settings.tab == tab_value or block.settings.tab == 'both' -%}
                  <li class="hot-this-week__product" {{ block.shopify_attributes }}>
                    {% render 'hot-this-week-card',
                      block: block,
                      section: section,
                      lazy_load: 'lazy'
                    %}
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="hot-this-week__empty">
            {%- if request.design_mode -%}
              Add a product card block and assign it to this tab in the Theme Editor.
            {%- else -%}
              {{ 'sections.collection_template.empty' | t }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</hot-this-week>

{% schema %}
{
  "name": "Hot this week",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hot This Week" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show tabs", "default": true },
    { "type": "text", "id": "best_sellers_label", "label": "Tab 1 label", "default": "Best Sellers" },
    { "type": "text", "id": "new_arrivals_label", "label": "Tab 2 label", "default": "New Arrivals" },
    {
      "type": "select", "id": "default_tab", "label": "Default active tab", "default": "best_sellers",
      "options": [
        { "value": "best_sellers", "label": "Best sellers" },
        { "value": "new_arrivals", "label": "New arrivals" }
      ]
    },
    { "type": "text", "id": "tabs_accessibility_label", "label": "Tabs accessibility label", "default": "Product collections" },

    { "type": "header", "content": "Product cards" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop products per row", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Tablet products per row", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Mobile products per row", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_content_spacing", "label": "Space below image", "min": 4, "max": 30, "step": 1, "unit": "px", "default": 12 },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "3 / 4",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall portrait" }
      ]
    },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ]
    },
    { "type": "range", "id": "product_title_size", "label": "Product title size", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 18 },

    { "type": "header", "content": "Description" },
    { "type": "color", "id": "description_color", "label": "Description text", "default": "#6E7787" },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "description_lines", "label": "Description max lines", "min": 1, "max": 4, "step": 1, "default": 2 },

    { "type": "header", "content": "Badge" },
    { "type": "range", "id": "badge_offset", "label": "Badge inset", "min": 4, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#7961D7" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#FFFFFF" },

    { "type": "header", "content": "Discount badge" },
    { "type": "color", "id": "compare_price_color", "label": "Compare-at price text", "default": "#8A93A0" },
    { "type": "color", "id": "discount_pill_background", "label": "Discount pill background", "default": "#00B878" },
    { "type": "color", "id": "discount_pill_text", "label": "Discount pill text", "default": "#FFFFFF" },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n7" },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 44, "step": 1, "unit": "px", "default": 28 },
    {
      "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "700",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": -10, "max": 10, "step": 1, "unit": "px", "default": -3 },
    { "type": "range", "id": "tab_font_size", "label": "Tab font size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Tabs" },
    { "type": "range", "id": "tab_height", "label": "Tab height", "min": 28, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "tab_padding", "label": "Horizontal padding", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "tab_radius", "label": "Corner radius", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "tab_gap", "label": "Gap", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 4 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#F0F3F5" },
    { "type": "color", "id": "tab_text", "label": "Inactive tab text", "default": "#111111" },
    { "type": "color", "id": "tab_active_background", "label": "Active tab background", "default": "#EEEEEC" },
    { "type": "color", "id": "tab_active_text", "label": "Active tab text", "default": "#111111" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "header_spacing", "label": "Space below heading", "min": 12, "max": 60, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top", "label": "Section top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Section bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_inline", "label": "Desktop side padding", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "mobile_padding_inline", "label": "Mobile side padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "header", "content": "Product" },
        { "type": "product", "id": "product", "label": "Shopify product", "info": "Used for image, title, price and link unless overridden below." },

        { "type": "header", "content": "Content overrides" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image", "info": "Overrides the product's featured image." },
        { "type": "text", "id": "custom_title", "label": "Custom title", "info": "Overrides the product title." },
        { "type": "textarea", "id": "description", "label": "Description", "info": "Short line shown under the title." },
        { "type": "url", "id": "custom_link", "label": "Custom link", "info": "Overrides the product URL. Leave blank to link to the selected product." },

        { "type": "header", "content": "Badge" },
        { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": false },
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "NEW" },

        { "type": "header", "content": "Pricing" },
        { "type": "paragraph", "content": "Leave blank to use the selected product's actual price with Shopify's money formatting." },
        { "type": "text", "id": "custom_price", "label": "Custom price", "info": "e.g. $9.99 or From $2.99" },
        { "type": "text", "id": "custom_compare_price", "label": "Custom compare-at price", "info": "e.g. $11.75" },

        { "type": "header", "content": "Discount badge" },
        { "type": "checkbox", "id": "show_discount", "label": "Show discount badge", "default": false },
        { "type": "text", "id": "discount_text", "label": "Discount text", "info": "e.g. 15% off. Leave blank to auto-calculate from the product's compare-at price." },

        { "type": "header", "content": "Tab" },
        {
          "type": "select", "id": "tab", "label": "Show in tab", "default": "best_sellers",
          "options": [
            { "value": "best_sellers", "label": "Best Sellers" },
            { "value": "new_arrivals", "label": "New Arrivals" },
            { "value": "both", "label": "Show in both" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hot this week",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Charm Bundle",
            "description": "Pick any four charms and save — mix letters, numbers and shapes in whichever colours you like.",
            "show_badge": true,
            "badge_text": "New",
            "custom_price": "$9.99",
            "custom_compare_price": "$11.75",
            "show_discount": true,
            "discount_text": "15% off",
            "tab": "best_sellers"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Waterproof Dog Leash + Collar Set",
            "description": "5ft leash + waterproof collar + charm add-ons.",
            "custom_price": "$60.00",
            "custom_compare_price": "$63.00",
            "show_discount": true,
            "discount_text": "4% off",
            "tab": "best_sellers"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Letter Charm — Personalised Collar Add-on",
            "description": "Three colours, fits 5/8\" and 1\" collar widths.",
            "custom_price": "$2.99",
            "tab": "new_arrivals"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "Number Charm",
            "description": "Add a house number or birth year — same three colours as the letters.",
            "custom_price": "From $2.99",
            "tab": "new_arrivals"
          }
        }
      ]
    }
  ]
}
{% endschema %}
