<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Product card — final</title>
<style>
  :root{
    --ink:          #12294d;   /* title, current price */
    --ink-muted:    #7b8697;   /* description, struck price */
    --media-bg:     #f6efe9;   /* cream photo panel */
    --card-bg:      #ffffff;
    --hairline:     #ebe6e1;
    --sale:         #00b878;   /* discount pill — green = money saved */
    --flag:         #12294d;   /* corner flag — navy = product status */
    --radius-card:  14px;
    --radius-media: 12px;
    --radius-pill:  999px;
  }

  *{box-sizing:border-box}
  body{
    margin:0; padding:0;
    background:#f7f8fa;
    font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif;
    color:var(--ink);
  }

  /* section wrapper — the card should never sit flush against the edges */
  .product-section{
    padding-block:36px;     /* 36px top + bottom */
    padding-inline:20px;
  }

  /* ---------- SECTION HEADER ---------- */
  .section__head{
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:16px;
    max-width:1040px;
    margin:0 auto 24px;      /* 24px down to the first row of cards */
  }
  .section__title{
    margin:0;
    font-size:28px; font-weight:800; letter-spacing:-.01em;
    color:var(--ink);
  }
  .section__tabs{ display:flex; gap:4px }
  .tab{
    border:0; background:transparent;
    font:inherit; font-size:14px; font-weight:600;
    color:var(--ink-muted);
    padding:9px 18px; border-radius:var(--radius-pill);
    cursor:pointer;
    transition:background .15s ease, color .15s ease;
  }
  .tab:hover{ color:var(--ink) }
  .tab:focus-visible{ outline:2px solid var(--ink); outline-offset:2px }
  .tab[aria-pressed="true"]{ background:#eceef2; color:var(--ink) }

  @media (max-width:520px){
    .section__head{ margin-bottom:18px }
    .section__title{ font-size:22px }
    .section__tabs{ width:100%; overflow-x:auto }
  }

  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
    gap:20px;
    max-width:1040px;
    margin:0 auto;
  }

  /* ---------- CARD ---------- */
  .card{
    display:flex; flex-direction:column;
    background:var(--card-bg);
    border:1px solid var(--hairline);
    border-radius:var(--radius-card);
    padding:10px 10px 14px;
    text-decoration:none; color:inherit;
    transition:box-shadow .18s ease, transform .18s ease;
  }
  .card:hover{ box-shadow:0 6px 20px rgba(18,41,77,.08); transform:translateY(-2px) }
  .card:focus-visible{ outline:2px solid var(--ink); outline-offset:3px }

  /* ---------- MEDIA ---------- */
  .card__media{
    position:relative;
    background:var(--media-bg);
    border-radius:var(--radius-media);
    aspect-ratio:1/1;
    display:grid; place-items:center;
    overflow:hidden;
    margin-bottom:12px;
  }
  .card__media img{ width:100%; height:100%; object-fit:contain }

  /* render only when the product is flagged new */
  .card__flag{
    position:absolute; top:8px; left:8px;
    background:var(--flag); color:#fff;
    font-size:10.5px; font-weight:700;
    letter-spacing:.06em; text-transform:uppercase;
    padding:4px 10px; border-radius:var(--radius-pill);
  }

  /* ---------- BODY ---------- */
  .card__body{
    display:flex; flex-direction:column; gap:4px;
    flex:1; padding:0 4px;
  }
  .card__title{ margin:0; font-size:15px; font-weight:700; line-height:1.3 }
  .card__desc{
    margin:0;
    font-size:12.5px; line-height:1.45;
    color:var(--ink-muted);
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
    overflow:hidden;
    min-height:2.9em;      /* holds the space when there's no description */
  }

  /* ---------- PRICES ---------- */
  .card__prices{
    display:flex; flex-wrap:wrap; align-items:center; gap:8px;
    margin-top:auto;       /* pins the row to the bottom of every card */
    padding-top:8px;
  }
  .price{ font-size:15px; font-weight:700 }
  .price--was{                                   /* render only when discounted */
    font-size:13px; font-weight:500;
    color:var(--ink-muted);
    text-decoration:line-through;
    text-decoration-thickness:1.5px;
  }
  .tag{                                          /* render only when discounted */
    background:var(--sale); color:#fff;
    font-size:11.5px; font-weight:700;
    padding:3px 9px; border-radius:var(--radius-pill);
    white-space:nowrap;
  }

  .sr-only{
    position:absolute; width:1px; height:1px; padding:0; margin:-1px;
    overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0;
  }

  @media (prefers-reduced-motion:reduce){
    .card{ transition:none }
    .card:hover{ transform:none }
  }

  /* demo-only: stands in for the product photo */
  .letters{ text-align:center; font-weight:800; font-size:34px; letter-spacing:.12em; color:#e8b93c }
  .letters span{ display:block; font-size:10px; font-weight:600; color:#8a8178; letter-spacing:0; margin-top:2px }
</style>
</head>
<body>

<section class="product-section">

  <div class="section__head">
    <h2 class="section__title">Hot This Week</h2>
    <div class="section__tabs">
      <button class="tab" type="button" aria-pressed="true">Best Sellers</button>
      <button class="tab" type="button" aria-pressed="false">New Arrivals</button>
    </div>
  </div>

<div class="grid">

  <a class="card" href="#">
    <div class="card__media">
      <span class="card__flag">New</span>
      <!-- <img src="charm-bundle.jpg" alt="Charm bundle"> -->
      <div class="letters">A B C<span>Yellow</span></div>
    </div>

    <div class="card__body">
      <h3 class="card__title">Charm Bundle</h3>
      <p class="card__desc">Pick any four charms and save — mix letters, numbers and shapes in whichever colours you like best.</p>

      <div class="card__prices">
        <span class="price">$9.99 CAD</span>
        <span class="price--was"><span class="sr-only">Original price</span>$11.75</span>
        <span class="tag">15% off</span>
      </div>
    </div>
  </a>

</div>
</section>
</body>
</html>