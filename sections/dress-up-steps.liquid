{{ 'dress-up-steps.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dress-up-steps.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} {
    --ds-background: {{ section.settings.background }};
    --ds-text: {{ section.settings.text_color }};
    --ds-muted: {{ section.settings.muted_text }};
    --ds-panel: {{ section.settings.panel_background }};
    --ds-surface: {{ section.settings.card_background }};
    --ds-media: {{ section.settings.image_background }};
    --ds-border: {{ section.settings.border_color }};
    --ds-accent: {{ section.settings.accent }};
    --ds-accent-text: {{ section.settings.accent_text }};
    --ds-number-background: {{ section.settings.number_background }};
    --ds-number-text: {{ section.settings.number_text }};

    --ds-max-width: {{ section.settings.max_width }}px;
    --ds-padding-top: {{ section.settings.padding_top }}px;
    --ds-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ds-padding-inline: {{ section.settings.padding_inline }}px;
    --ds-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --ds-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --ds-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    --ds-heading-gap: {{ section.settings.heading_gap }}px;

    --ds-per-row: {{ section.settings.cards_per_row }};
    --ds-gap: {{ section.settings.card_gap }}px;
    --ds-image-ratio: {{ section.settings.image_ratio }};
    --ds-image-fit: {{ section.settings.image_fit }};
    --ds-radius-card: {{ section.settings.card_radius }}px;

    --ds-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --ds-heading-size: {{ section.settings.heading_size }}px;
    --ds-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ds-heading-weight: {{ section.settings.heading_weight }};
    --ds-step-title-size: {{ section.settings.step_title_size }}px;
    --ds-mobile-step-title-size: {{ section.settings.mobile_step_title_size }}px;
    --ds-price-size: {{ section.settings.price_size }}px;
  }
{%- endstyle -%}

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign step_count = step_blocks.size
-%}

<dress-up-steps
  class="dress-up-steps"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-error-message="{{ section.settings.error_message | escape }}"
  data-locked-message="{{ section.settings.locked_message | escape }}"
  data-limit-message="{{ section.settings.limit_message | escape }}"
>
  <div class="dress-up-steps__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="dress-up-steps__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dress-up-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dress-up-steps__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="dress-up-steps__steps">
      {%- for block in step_blocks -%}
        {%- liquid
          assign step_number = forloop.index
          assign panel_id = 'DressPanel-' | append: section.id | append: '-' | append: block.id
          assign field_id = 'DressText-' | append: section.id | append: '-' | append: block.id
          assign is_final = false
          if step_number == step_count
            assign is_final = true
          endif

          # Merchant-picked products win; the collection is the fallback.
          assign step_products = block.settings.products
          if step_products == blank and block.settings.collection != blank
            assign step_products = block.settings.collection.products
          endif

          assign product_limit = block.settings.products_to_show
          if product_limit == 0
            assign product_limit = 50
          endif

          assign per_row = block.settings.cards_per_row
          if per_row == 0
            assign per_row = section.settings.cards_per_row
          endif

          assign property_label = block.settings.personalization_label | default: 'Name'
          assign layout = block.settings.layout | default: 'grid'
          assign is_carousel = false
          if layout == 'carousel'
            assign is_carousel = true
          endif
        -%}

        <section
          class="ds-step"
          data-dress-step
          data-index="{{ forloop.index0 }}"
          data-max="{{ block.settings.max_selections }}"
          {% if block.settings.selection_required %}data-required{% endif %}
          {% if is_final %}data-final{% endif %}
          style="--ds-per-row: {{ per_row }};"
          {{ block.shopify_attributes }}
        >
          <div class="ds-step__head">
            <button
              class="ds-step__toggle"
              type="button"
              aria-expanded="{% if step_number == 1 %}true{% else %}false{% endif %}"
              aria-controls="{{ panel_id }}"
              data-dress-toggle
            >
              <span class="ds-step__number" aria-hidden="true">{{ step_number }}</span>
              <span class="ds-step__title">{{ block.settings.title | escape }}</span>
            </button>

            {%- comment -%}
              A saved step collapses to this pill. Its close button reopens the
              step for editing, so a closed row carries one control, not two.
            {%- endcomment -%}
            <p class="ds-step__pill" data-dress-pill hidden>
              <img class="ds-step__pill-image" alt="" width="20" height="20" data-dress-pill-image hidden>
              <span class="ds-step__pill-text" data-dress-pill-text></span>
              <button class="ds-step__pill-remove" type="button" data-dress-edit>
                <span class="visually-hidden">{{ 'customer.addresses.edit' | t }}: {{ block.settings.title | escape }}</span>
                <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false">
                  <path d="M1 1l8 8M9 1l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </p>

            <div class="ds-step__actions">
              <p class="ds-step__price" data-dress-price aria-live="polite">{{ 0 | money }}</p>

              {%- if is_final -%}
                <button class="ds-button ds-button--primary" type="button" data-dress-checkout aria-disabled="true">
                  <span class="ds-button__icon svg-wrapper" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
                  <span>{{ section.settings.cta_label | escape }}</span>
                  <span class="ds-button__spinner" data-dress-spinner hidden></span>
                </button>
              {%- else -%}
                <button class="ds-button ds-button--primary" type="button" data-dress-save aria-disabled="true">
                  {{- section.settings.button_label | escape -}}
                </button>
              {%- endif -%}
            </div>
          </div>

          <div class="ds-step__panel" id="{{ panel_id }}" data-dress-panel {% unless step_number == 1 %}hidden{% endunless %}>
            {%- if block.settings.enable_personalization or is_carousel -%}
              <div class="ds-step__toolbar">
                {%- if block.settings.enable_personalization -%}
                  <div class="ds-field">
                    <label class="ds-field__label" for="{{ field_id }}">{{ property_label | escape }}</label>
                    <input
                      class="ds-field__input"
                      type="text"
                      id="{{ field_id }}"
                      placeholder="{{ block.settings.personalization_placeholder | escape }}"
                      maxlength="{{ block.settings.personalization_max_chars }}"
                      autocomplete="off"
                      data-dress-text
                      data-property="{{ property_label | escape }}"
                      {% if block.settings.personalization_required %}data-text-required{% endif %}
                    >
                  </div>
                {%- endif -%}

                {%- if is_carousel -%}
                  <div class="ds-step__arrows" data-dress-arrows>
                    <button class="ds-arrow" type="button" data-dress-scroll="-1" aria-controls="{{ panel_id }}">
                      <span class="visually-hidden">{{ 'general.slider.previous_slide' | t }}</span>
                      <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M7.5 1.5 3 6l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <button class="ds-arrow" type="button" data-dress-scroll="1" aria-controls="{{ panel_id }}">
                      <span class="visually-hidden">{{ 'general.slider.next_slide' | t }}</span>
                      <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M4.5 1.5 9 6l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if step_products.first != blank -%}
              <div
                class="ds-track"
                data-layout="{{ layout }}"
                data-dress-track
                role="group"
                aria-label="{{ block.settings.title | escape }}"
              >
                {%- for product in step_products limit: product_limit -%}
                  {% render 'dress-up-product-card',
                    product: product,
                    section: section,
                    block: block,
                    index: forloop.index,
                    show_options: block.settings.show_options,
                    option_names: block.settings.option_names,
                    show_quantity: block.settings.enable_quantity,
                    loading: 'lazy'
                  %}
                {%- endfor -%}
              </div>
            {%- elsif request.design_mode -%}
              <p class="ds-step__empty">Choose products or a collection for this step in the Theme Editor.</p>
            {%- endif -%}
          </div>

          <p class="ds-step__error" data-dress-error role="alert" hidden></p>
        </section>
      {%- endfor -%}
    </div>
  </div>
</dress-up-steps>

{% schema %}
{
  "name": "Dress up in steps",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Design Yourself" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Pick - Pair - Play!" },

    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "button_label", "label": "Step button", "default": "Save and continue" },
    { "type": "text", "id": "cta_label", "label": "Final button", "default": "Go to cart" },
    { "type": "text", "id": "error_message", "label": "Incomplete step message", "default": "Almost there! Make a pick here and we'll keep going." },
    { "type": "text", "id": "locked_message", "label": "Locked step message", "default": "Let's finish the step above first, then this one opens up." },
    { "type": "text", "id": "limit_message", "label": "Selection limit message", "default": "That's the maximum here. Remove one to swap it out.", "info": "Shown when a customer picks more than a step allows." },

    { "type": "header", "content": "Product cards" },
    { "type": "range", "id": "cards_per_row", "label": "Cards in view", "min": 2, "max": 8, "step": 1, "default": 4, "info": "Default for every step. Each step can override it. Cards always fit whole — a step never shows a half card." },
    { "type": "range", "id": "card_gap", "label": "Space between cards", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "4 / 5", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "3 / 4", "label": "Tall portrait" }] },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain", "options": [{ "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }] },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 14 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 22, "max": 42, "step": 1, "unit": "px", "default": 28 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "700", "options": [{ "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }] },
    { "type": "range", "id": "step_title_size", "label": "Step title size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_step_title_size", "label": "Mobile step title size", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 18 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_text", "label": "Secondary text", "default": "#6B7280" },
    { "type": "color", "id": "panel_background", "label": "Step background", "default": "#F4F4F4" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#E9EEF1" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#E2E2E2" },
    { "type": "color", "id": "accent", "label": "Accent (buttons and selection)", "default": "#F96D4B" },
    { "type": "color", "id": "accent_text", "label": "Accent text", "default": "#FFFFFF" },
    { "type": "color", "id": "number_background", "label": "Step number background", "default": "#050505" },
    { "type": "color", "id": "number_text", "label": "Step number text", "default": "#FFFFFF" },

    { "type": "header", "content": "Layout and spacing" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "heading_gap", "label": "Space below heading", "min": 20, "max": 70, "step": 2, "unit": "px", "default": 38 },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_inline", "label": "Desktop side padding", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_padding_inline", "label": "Mobile side padding", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick a collar you love" },

        { "type": "header", "content": "Products" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 50, "info": "Pick, reorder or remove the cards shown in this step. Leave empty to use the collection below." },
        { "type": "collection", "id": "collection", "label": "Fallback collection" },
        { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 0, "max": 50, "step": 1, "default": 0, "info": "0 shows every product, up to the 50 Shopify returns to a section." },

        { "type": "header", "content": "Choices" },
        { "type": "range", "id": "max_selections", "label": "Products a customer can pick", "min": 1, "max": 12, "step": 1, "default": 1, "info": "1 keeps this step single choice. Each pick keeps its own options and quantity, and becomes its own cart line." },
        { "type": "checkbox", "id": "selection_required", "label": "Selection required to continue", "default": true, "info": "Turn off for optional extras." },
        { "type": "checkbox", "id": "show_options", "label": "Show product options (size, color, ...)", "default": true, "info": "Option values and prices come straight from each product's variants." },
        { "type": "text", "id": "option_names", "label": "Options to show", "info": "Comma separated, for example: Size. Leave empty to show every option a product has." },
        { "type": "checkbox", "id": "enable_quantity", "label": "Show quantity control", "default": true },

        { "type": "header", "content": "Layout" },
        { "type": "select", "id": "layout", "label": "Card layout", "default": "grid", "options": [{ "value": "grid", "label": "Grid (wraps onto new rows)" }, { "value": "carousel", "label": "Carousel (scrolls sideways)" }], "info": "Use the carousel for long lists such as letters." },
        { "type": "range", "id": "cards_per_row", "label": "Cards in view", "min": 0, "max": 8, "step": 1, "default": 0, "info": "0 uses the section setting." },

        { "type": "header", "content": "Personalization" },
        { "type": "checkbox", "id": "enable_personalization", "label": "Show text field", "default": false },
        { "type": "text", "id": "personalization_label", "label": "Field label", "default": "Name", "info": "Also the line item property name shown in the cart and on orders." },
        { "type": "text", "id": "personalization_placeholder", "label": "Field placeholder", "default": "Enter a name" },
        { "type": "range", "id": "personalization_max_chars", "label": "Maximum characters", "min": 3, "max": 40, "step": 1, "default": 12 },
        { "type": "checkbox", "id": "personalization_required", "label": "Required to continue", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dress up in steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Pick a collar",
            "max_selections": 2,
            "layout": "grid",
            "cards_per_row": 4,
            "option_names": "Size"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Match it with letters",
            "max_selections": 12,
            "layout": "carousel",
            "cards_per_row": 6,
            "enable_personalization": true,
            "personalization_required": false
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Add fun extras",
            "max_selections": 6,
            "selection_required": false,
            "layout": "grid",
            "cards_per_row": 4,
            "option_names": "Size"
          }
        }
      ]
    }
  ]
}
{% endschema %}
