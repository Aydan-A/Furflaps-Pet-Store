{{ 'product-feature-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign added_label = section.settings.added_label | default: 'Added'

  # theme-check-disable BlockIdUsage
  assign first_tab_id = blank
  for block in section.blocks
    if block.type == 'tab'
      assign first_tab_id = block.id
      break
    endif
  endfor
  # theme-check-enable BlockIdUsage
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --pft-background: {{ section.settings.background_color }};
    --pft-text: {{ section.settings.text_color }};
    --pft-card-background: {{ section.settings.card_background }};
    --pft-feature-border: {{ section.settings.feature_border }};
    --pft-tab-shell: {{ section.settings.tab_shell_background }};
    --pft-tab-border: {{ section.settings.tab_border }};
    --pft-tab-text: {{ section.settings.tab_text }};
    --pft-active-background: {{ section.settings.active_tab_background }};
    --pft-active-text: {{ section.settings.active_tab_text }};
    --pft-add-background: {{ section.settings.add_button_background }};
    --pft-add-text: {{ section.settings.add_button_text }};
    --pft-padding-top: {{ section.settings.padding_top }}px;
    --pft-padding-bottom: {{ section.settings.padding_bottom }}px;
    --pft-padding-inline: {{ section.settings.padding_inline }}px;
    --pft-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --pft-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --pft-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    --pft-header-gap: {{ section.settings.header_gap }}px;
    --pft-tabs-gap: {{ section.settings.tabs_gap }}px;
    --pft-card-gap: {{ section.settings.card_gap }}px;
    --pft-card-radius: {{ section.settings.card_radius }}px;
    --pft-columns: {{ section.settings.columns_desktop }};
    --pft-columns-tablet: {{ section.settings.columns_tablet }};
    --pft-columns-mobile: {{ section.settings.columns_mobile }};
    --pft-image-ratio: {{ section.settings.image_ratio }};
    --pft-image-fit: {{ section.settings.image_fit }};
    --pft-alignment: {{ section.settings.alignment }};
    --pft-tabs-alignment: {{ section.settings.tabs_alignment }};
    --pft-tab-height: {{ section.settings.tab_height }}px;
    --pft-tab-padding: {{ section.settings.tab_padding }}px;
    --pft-tab-gap: {{ section.settings.tab_gap }}px;
    --pft-tab-radius: {{ section.settings.tab_radius }}px;
    --pft-tab-shell-radius: {{ section.settings.tab_shell_radius }}px;
    --pft-tab-shell-padding: {{ section.settings.tab_shell_padding }}px;
    --pft-tab-size: {{ section.settings.tab_font_size }}px;
  }
{%- endstyle -%}

<product-feature-tabs class="product-feature-tabs">
  <div class="product-feature-tabs__inner">
    {%- if section.settings.show_header -%}
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <header class="product-feature-tabs__header" style="text-align: {{ section.settings.alignment }};">
          {%- if section.settings.heading != blank -%}<h2 class="product-feature-tabs__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="product-feature-tabs__text rte">{{ section.settings.text }}</div>{%- endif -%}
        </header>
      {%- endif -%}
    {%- endif -%}

    {%- if first_tab_id != blank -%}
      {% comment %}theme-check-disable BlockIdUsage{% endcomment %}
      <div class="product-feature-tabs__tabs-wrap">
        <div class="product-feature-tabs__tabs" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- assign is_active = false -%}{%- if block.id == first_tab_id -%}{%- assign is_active = true -%}{%- endif -%}
              <button class="product-feature-tabs__tab" id="PftTab-{{ section.id }}-{{ block.id }}" type="button" role="tab" aria-selected="{{ is_active }}" aria-controls="PftPanel-{{ section.id }}-{{ block.id }}" tabindex="{% if is_active %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>
                {{ block.settings.label | default: block.settings.collection.title | escape }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <div class="product-feature-tabs__panel" id="PftPanel-{{ section.id }}-{{ block.id }}" role="tabpanel" aria-labelledby="PftTab-{{ section.id }}-{{ block.id }}" tabindex="0" {% unless block.id == first_tab_id %}hidden{% endunless %}>
            {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
              <ul class="product-feature-tabs__grid" role="list">
                {%- for product in block.settings.collection.products limit: section.settings.products_to_show -%}
                  {%- liquid
                    assign product_form_id = 'PftForm-' | append: section.id | append: '-' | append: block.id | append: '-' | append: forloop.index
                    assign selected_variant = product.selected_or_first_available_variant
                    if product.featured_media != blank
                      for product_variant in product.variants
                        if product_variant.featured_media.id == product.featured_media.id
                          assign selected_variant = product_variant
                          break
                        endif
                      endfor
                    endif
                    assign color_value = blank
                    assign color_swatch_style = blank
                    assign color_metafield = product.metafields.custom.color
                    if color_metafield == blank
                      assign color_metafield = product.metafields.custom.colour
                    endif

                    for product_option in product.options_with_values
                      assign option_name = product_option.name | downcase
                      if option_name == 'color' or option_name == 'colour'
                        assign color_value = selected_variant.options[forloop.index0]
                        for option_value in product_option.values
                          if option_value == color_value
                            if option_value.swatch.color
                              assign color_swatch_style = 'background-color: rgb(' | append: option_value.swatch.color.rgb | append: ');'
                            elsif option_value.swatch.image
                              assign color_swatch_url = option_value.swatch.image | image_url: width: 60
                              assign color_swatch_style = 'background-image: url(' | append: color_swatch_url | append: ');'
                            endif
                            break
                          endif
                        endfor
                      endif
                    endfor

                    if color_value == blank
                      if color_metafield.type contains 'metaobject_reference'
                        assign color_reference = color_metafield.value
                        if color_metafield.type contains 'list.'
                          assign color_reference = color_metafield.value | first
                        endif
                        assign color_value = color_reference.label.value | default: color_reference.name.value | default: color_reference.title.value | default: color_reference.color_name.value | default: color_reference.colour_name.value | default: color_reference.display_name.value
                        if color_value == blank and color_reference.system.handle != blank
                          assign color_value = color_reference.system.handle | replace: '-', ' ' | capitalize
                        endif
                        assign referenced_color = color_reference.color.value | default: color_reference.colour.value | default: color_reference.hex.value | default: color_reference.hex_code.value
                        if referenced_color != blank
                          assign color_swatch_style = 'background-color: ' | append: referenced_color | append: ';'
                        endif
                      elsif color_metafield.type == 'list.single_line_text_field'
                        assign color_value = color_metafield.value | first
                      elsif color_metafield.type == 'single_line_text_field' or color_metafield.type == 'color'
                        assign color_value = color_metafield.value
                      endif
                    endif

                    if color_swatch_style == blank and color_value != blank
                      assign color_key = color_value | handleize
                      case color_key
                        when 'sky-blue'
                          assign color_swatch_color = '#BFE8F7'
                        when 'mint-green'
                          assign color_swatch_color = '#A8E3CE'
                        when 'lilac'
                          assign color_swatch_color = '#C8A7E8'
                        when 'yellow'
                          assign color_swatch_color = '#F5D94E'
                        when 'light-blue'
                          assign color_swatch_color = '#ADD8E6'
                        when 'dark-blue'
                          assign color_swatch_color = '#24518A'
                        else
                          assign color_swatch_color = color_key | remove: '-'
                      endcase
                      assign color_swatch_style = 'background-color: ' | append: color_swatch_color | append: ';'
                    endif

                    assign quantity_min = selected_variant.quantity_rule.min | default: 1
                    assign quantity_step = selected_variant.quantity_rule.increment | default: 1
                    assign quantity_max = selected_variant.quantity_rule.max
                  -%}
                  <li class="product-feature-tabs__item">
                    <article class="product-feature-tabs__card">
                      <a class="product-feature-tabs__card-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                        <div class="product-feature-tabs__media">
                          {%- if product.featured_media -%}
                            {{ product.featured_media | image_url: width: 1000 | image_tag: class: 'product-feature-tabs__image', widths: '240, 360, 480, 640, 800, 1000', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 78vw', loading: 'lazy' }}
                          {%- else -%}
                            {{ 'product-apparel-1' | placeholder_svg_tag: 'product-feature-tabs__placeholder' }}
                          {%- endif -%}
                        </div>
                      </a>
                      <div class="product-feature-tabs__details">
                        <div class="product-feature-tabs__color">
                          <span class="product-feature-tabs__swatch"{% if color_swatch_style != blank %} style="{{ color_swatch_style }}"{% endif %} aria-hidden="true"></span>
                          {%- if color_value != blank -%}<span>{{ color_value | escape }}</span>{%- endif -%}
                        </div>
                        <div
                          class="product-feature-tabs__quantity"
                          data-pft-quantity
                          data-min="{{ quantity_min }}"
                          data-step="{{ quantity_step }}"
                          {% if quantity_max != blank %}data-max="{{ quantity_max }}"{% endif %}
                        >
                          <button class="product-feature-tabs__quantity-button" type="button" data-pft-quantity-change="-1" aria-label="Decrease quantity for {{ product.title | escape }}">&minus;</button>
                          <output class="product-feature-tabs__quantity-value" aria-live="polite">{{ quantity_min }}</output>
                          <button class="product-feature-tabs__quantity-button" type="button" data-pft-quantity-change="1" aria-label="Increase quantity for {{ product.title | escape }}">+</button>
                        </div>
                      </div>
                      <product-form class="product-feature-tabs__product-form" data-section-id="{{ section.id }}">
                        {%- form 'product', product, id: product_form_id, class: 'product-feature-tabs__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                          <input type="hidden" name="id" value="{{ selected_variant.id }}" class="product-variant-id">
                          <input type="hidden" name="quantity" value="{{ quantity_min }}">
                          <button
                            class="product-feature-tabs__add"
                            type="submit"
                            name="add"
                            data-pft-add
                            {% unless selected_variant.available %}disabled{% endunless %}
                          >
                            {%- comment -%}
                              Two stacked faces: the default one carries the accessible name, the
                              success one is hidden from assistive tech so the label never changes.
                            {%- endcomment -%}
                            <span class="product-feature-tabs__add-faces">
                              <span class="product-feature-tabs__add-face">
                                {%- if selected_variant.available -%}
                                  <span class="product-feature-tabs__add-stage" aria-hidden="true">
                                    <span class="product-feature-tabs__add-icon product-feature-tabs__add-icon--drop">
                                      {{- 'icon-box.svg' | inline_asset_content -}}
                                    </span>
                                    <span class="product-feature-tabs__add-icon product-feature-tabs__add-icon--cart">
                                      {{- 'icon-cart.svg' | inline_asset_content -}}
                                    </span>
                                  </span>
                                {%- endif -%}
                                <span class="product-feature-tabs__add-label">{% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                              </span>
                              {%- if selected_variant.available -%}
                                <span class="product-feature-tabs__add-face product-feature-tabs__add-face--success" aria-hidden="true">
                                  <span class="product-feature-tabs__add-icon product-feature-tabs__add-icon--check">
                                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                                  </span>
                                  <span class="product-feature-tabs__add-label">{{ added_label | escape }}</span>
                                </span>
                              {%- endif -%}
                            </span>
                            {%- render 'loading-spinner' -%}
                          </button>
                          <div class="product-form__error-message-wrapper" role="alert" hidden>
                            <span class="product-form__error-message"></span>
                          </div>
                        {%- endform -%}
                      </product-form>
                    </article>
                  </li>
                {%- endfor -%}
              </ul>
            {%- elsif request.design_mode -%}
              <div class="product-feature-tabs__empty">Choose a collection for this tab in the Theme Editor.</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      {% comment %}theme-check-enable BlockIdUsage{% endcomment %}
    {%- elsif request.design_mode -%}
      <div class="product-feature-tabs__empty">Add a tab block, then choose its collection.</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="product-feature-tabs__footer"><a class="product-feature-tabs__button button{% if section.settings.button_style == 'secondary' %} button--secondary{% endif %}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</product-feature-tabs>

<script>
  if (!customElements.get('product-feature-tabs')) {
    customElements.define('product-feature-tabs', class extends HTMLElement {
      connectedCallback() {
        this.tabs = [...this.querySelectorAll('[role="tab"]')];
        this.panels = [...this.querySelectorAll('[role="tabpanel"]')];
        this.addEventListener('click', this.onClick);
        this.addEventListener('keydown', this.onKeydown);

        // Capture phase so we see the submit before product-form.js flips aria-disabled.
        this.addEventListener('submit', this.onSubmit, true);
        this.addTimers = new WeakMap();
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', this.subscribeToCart, { once: true });
        } else {
          this.subscribeToCart();
        }
      }
      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        this.removeEventListener('keydown', this.onKeydown);
        this.removeEventListener('submit', this.onSubmit, true);
        document.removeEventListener('DOMContentLoaded', this.subscribeToCart);
        this.cartSubscriptions?.forEach((unsubscribe) => unsubscribe());
        this.cartSubscriptions = null;
      }

      subscribeToCart = () => {
        if (typeof subscribe !== 'function' || typeof PUB_SUB_EVENTS === 'undefined' || this.cartSubscriptions) return;
        this.cartSubscriptions = [
          subscribe(PUB_SUB_EVENTS.cartUpdate, (payload) => {
            if (!this.pendingAdd || payload?.source !== 'product-form') return;
            const { button, variantId } = this.pendingAdd;
            if (payload.productVariantId && String(payload.productVariantId) !== String(variantId)) return;
            this.pendingAdd = null;
            this.playAdded(button);
          }),
          subscribe(PUB_SUB_EVENTS.cartError, () => { this.pendingAdd = null; }),
        ];
      };

      onSubmit = (event) => {
        const button = event.target.querySelector?.('[data-pft-add]');
        // product-form.js ignores submits while a request is in flight; mirror that guard.
        if (!button || button.disabled || button.getAttribute('aria-disabled') === 'true') return;
        this.resetAddButton(button);
        this.pendingAdd = { button, variantId: event.target.querySelector('[name="id"]')?.value };
        // A dropped request never reports back, so don't leave a stale button waiting to animate.
        clearTimeout(this.pendingAddTimer);
        this.pendingAddTimer = setTimeout(() => { this.pendingAdd = null; }, 15000);
      };

      resetAddButton(button) {
        const timers = this.addTimers.get(button);
        if (timers) timers.forEach((timer) => clearTimeout(timer));
        this.addTimers.delete(button);
        button.removeAttribute('data-pft-state');
      }

      // Dawn opens the drawer a frame after the response, which would cover the
      // button mid-animation. Hold it back until the product has landed.
      deferCartDrawer(delay) {
        const drawer = document.querySelector('cart-drawer');
        if (!drawer || this.drawerDeferred || typeof drawer.open !== 'function') return;
        const open = drawer.open;
        let queued = null;
        this.drawerDeferred = true;
        drawer.open = (...args) => { queued = args; };
        setTimeout(() => {
          delete drawer.open;
          this.drawerDeferred = false;
          if (queued) open.apply(drawer, queued);
        }, delay);
      }

      playAdded(button) {
        if (!button.isConnected) return;
        this.resetAddButton(button);
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Patch synchronously: renderContents schedules the open before our next frame.
        if (!reduceMotion) this.deferCartDrawer(700);

        // Runs on the next frame so the loading spinner is already hidden when we measure.
        requestAnimationFrame(() => {
          if (!button.isConnected) return;
          const face = button.querySelector('.product-feature-tabs__add-face');
          const label = face?.querySelector('.product-feature-tabs__add-label');
          const stage = button.querySelector('.product-feature-tabs__add-stage');
          if (!face || !label || !stage) return;

          if (!reduceMotion) {
            // Slide the cart into the middle of the button by half the space the text leaves behind.
            const styles = getComputedStyle(face);
            const gap = parseFloat(styles.columnGap) || 0;
            const direction = styles.direction === 'rtl' ? -1 : 1;
            button.style.setProperty('--pft-add-shift', `${(direction * (label.offsetWidth + gap)) / 2}px`);
          }

          button.dataset.pftState = reduceMotion ? 'added' : 'dropping';
          const timers = [];
          if (!reduceMotion) {
            timers.push(setTimeout(() => { button.dataset.pftState = 'added'; }, 620));
          }
          timers.push(setTimeout(() => this.resetAddButton(button), reduceMotion ? 1200 : 1620));
          this.addTimers.set(button, timers);
        });
      }
      onClick = (event) => {
        const quantityButton = event.target.closest('[data-pft-quantity-change]');
        if (quantityButton) {
          const quantity = quantityButton.closest('[data-pft-quantity]');
          const output = quantity.querySelector('.product-feature-tabs__quantity-value');
          const minimum = Number(quantity.dataset.min || 0);
          const maximum = quantity.dataset.max ? Number(quantity.dataset.max) : Infinity;
          const step = Number(quantity.dataset.step || 1);
          const direction = Number(quantityButton.dataset.pftQuantityChange);
          output.value = Math.min(maximum, Math.max(minimum, Number(output.value) + direction * step));
          const quantityInput = quantity.closest('.product-feature-tabs__card').querySelector('[name="quantity"]');
          if (quantityInput) quantityInput.value = output.value;
          return;
        }
        const tab = event.target.closest('[role="tab"]');
        if (tab) this.select(tab);
      };
      onKeydown = (event) => {
        const tab = event.target.closest('[role="tab"]');
        if (!tab || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const current = this.tabs.indexOf(tab);
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? this.tabs.length - 1 : event.key === 'ArrowLeft' ? (current - 1 + this.tabs.length) % this.tabs.length : (current + 1) % this.tabs.length;
        this.select(this.tabs[next], true);
      };
      select(selected, focus = false) {
        this.tabs.forEach((tab) => { const active = tab === selected; tab.setAttribute('aria-selected', active); tab.tabIndex = active ? 0 : -1; });
        this.panels.forEach((panel) => { panel.hidden = panel.id !== selected.getAttribute('aria-controls'); });
        if (focus) selected.focus();
      }
    });
  }
</script>

{% schema %}
{
  "name": "Product feature tabs",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_header", "label": "Show header", "default": false },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop by ride" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }] },
    { "type": "select", "id": "alignment", "label": "Content alignment", "default": "center", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "primary", "options": [{ "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }] },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop products visible", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Tablet products visible", "min": 1, "max": 4, "step": 0.5, "default": 2.5 },
    { "type": "range", "id": "columns_mobile", "label": "Mobile products visible", "min": 1, "max": 2, "step": 0.1, "default": 1.2 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "4 / 5", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "3 / 4", "label": "Tall portrait" }] },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain", "options": [{ "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }] },
    { "type": "header", "content": "Tabs" },
    { "type": "text", "id": "tabs_label", "label": "Tabs accessibility label", "default": "Product categories" },
    { "type": "select", "id": "tabs_alignment", "label": "Tabs alignment", "default": "center", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" }] },
    { "type": "range", "id": "tab_height", "label": "Tab height", "min": 30, "max": 60, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "tab_padding", "label": "Tab horizontal padding", "min": 8, "max": 36, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "tab_font_size", "label": "Tab font size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "tab_gap", "label": "Gap between tabs", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "tab_radius", "label": "Tab corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 3 },
    { "type": "range", "id": "tab_shell_radius", "label": "Tabs container radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 3 },
    { "type": "range", "id": "tab_shell_padding", "label": "Tabs container padding", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 5 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F3F2F2" },
    { "type": "color", "id": "feature_border", "label": "Card footer border", "default": "#ECECEC" },
    { "type": "color", "id": "tab_shell_background", "label": "Tabs container", "default": "#F5F5F5" },
    { "type": "color", "id": "tab_border", "label": "Tabs border", "default": "#E4E4E4" },
