{{ 'before-after-comparison.css' | asset_url | stylesheet_tag }}
<script src="{{ 'before-after-comparison.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_product = section.settings.product
  assign show_product = false
  if section.settings.show_product and featured_product != blank
    assign show_product = true
  endif

  if show_product
    assign featured_variant = featured_product.selected_or_first_available_variant
    assign quantity_rule = featured_variant.quantity_rule
    comment
      Anything with options or quantity rules goes through the theme's quick-add
      modal so a customer never adds an arbitrary variant from the overlay.
    endcomment
    assign needs_options = false
    if featured_product.variants_count > 1 or quantity_rule.min > 1 or quantity_rule.max != null or quantity_rule.increment > 1
      assign needs_options = true
    endif
    assign product_form_id = 'BeforeAfterAdd-' | append: section.id | append: '-' | append: featured_product.id
  endif

  assign loading = 'lazy'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif

  comment
    Widths are expressed against the section's own container, not the viewport, so
    the browser picks the same source in the Theme Editor iframe as on the
    storefront. 116px is the page-width gutter pair plus the column gap; 0.6 is
    the image column's share of the grid.
  endcomment
  assign content_width = section.settings.content_width
  assign media_width = content_width | minus: 116 | times: 0.6 | round
  capture media_sizes
    echo '(min-width: '
    echo content_width
    echo 'px) '
    echo media_width
    echo 'px, (min-width: 750px) calc((100vw - 116px) * 0.6), calc(100vw - 30px)'
  endcapture
  assign media_widths = '375, 550, 750, 900, 1100, 1400, 1800, 2200'
-%}

{%- if show_product -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if needs_options -%}
    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    --bac-max-width: {{ section.settings.content_width }}px;

    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width before-after-comparison__container">
    <before-after-comparison
      class="before-after-comparison"
      style="--bac-position: {{ section.settings.initial_position }}%;"
    >
      <div class="before-after-comparison__content gradient color-{{ section.settings.color_scheme }}">
        <div class="before-after-comparison__content-inner">
          {%- if section.settings.heading != blank -%}
            <h2 class="before-after-comparison__heading h1">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="before-after-comparison__text rte">{{ section.settings.text }}</div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a
              class="before-after-comparison__button button"
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="before-after-comparison__media">
        <div class="before-after-comparison__image before-after-comparison__image--before">
          {%- if section.settings.before_image != blank -%}
            {{
              section.settings.before_image
              | image_url: width: 2200
              | image_tag:
                widths: media_widths,
                sizes: media_sizes,
                loading: loading,
                fetchpriority: fetch_priority
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'before-after-comparison__placeholder' }}
          {%- endif -%}
        </div>

        <div class="before-after-comparison__image before-after-comparison__image--after" aria-hidden="true">
          {%- if section.settings.after_image != blank -%}
            {{
              section.settings.after_image
              | image_url: width: 2200
              | image_tag:
                widths: media_widths,
                sizes: media_sizes,
                loading: loading,
                fetchpriority: fetch_priority
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'before-after-comparison__placeholder' }}
          {%- endif -%}
        </div>

        <div class="before-after-comparison__divider" aria-hidden="true">
          <span class="before-after-comparison__handle">
            <svg viewBox="0 0 28 18" aria-hidden="true" focusable="false">
              <path
                d="M10 3 4 9l6 6M18 3l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </div>

        <input
          class="before-after-comparison__range"
          data-comparison-range
          type="range"
          min="0"
          max="100"
          step="1"
          value="{{ section.settings.initial_position }}"
          aria-label="Compare the before and after images"
        >

        {%- if show_product -%}
          <div class="before-after-comparison__product">
            {%- if needs_options -%}
              <div class="before-after-comparison__product-card">
                <a
                  class="before-after-comparison__product-title"
                  href="{{ featured_product.url }}"
                  id="{{ product_form_id }}-title"
                >
                  {{- featured_product.title | escape -}}
                </a>
                <div class="before-after-comparison__product-action">
                  <modal-opener data-modal="#{{ product_form_id }}-modal">
                    <button
                      id="{{ product_form_id }}-submit"
                      type="button"
                      class="button"
                      aria-haspopup="dialog"
                      aria-labelledby="{{ product_form_id }}-submit {{ product_form_id }}-title"
                      data-product-url="{{ featured_product.url }}"
                    >
                      {{- 'products.product.choose_options' | t -}}
                      {%- render 'loading-spinner' -%}
                    </button>
                  </modal-opener>
                </div>
              </div>
            {%- else -%}
              <product-form class="before-after-comparison__product-form" data-section-id="{{ section.id }}">
                {%- form 'product',
                  featured_product,
                  id: product_form_id,
                  class: 'form',
                  novalidate: 'novalidate',
                  data-type: 'add-to-cart-form'
                -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ featured_variant.id }}"
                    class="product-variant-id"
                    {% if featured_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                  <div class="before-after-comparison__product-card">
                    <a
                      class="before-after-comparison__product-title"
                      href="{{ featured_product.url }}"
                      id="{{ product_form_id }}-title"
                    >
                      {{- featured_product.title | escape -}}
                    </a>
                    <div class="before-after-comparison__product-action">
                      <button
                        id="{{ product_form_id }}-submit"
                        type="submit"
                        name="add"
                        class="button"
                        aria-labelledby="{{ product_form_id }}-submit {{ product_form_id }}-title"
                        aria-live="polite"
                        data-sold-out-message="true"
                        {% if featured_variant.available == false %}
                          disabled
                        {% endif %}
                      >
                        <span>
                          {%- if featured_variant.available -%}
                            {{ 'products.product.add_to_cart' | t }}
                          {%- else -%}
                            {{ 'products.product.sold_out' | t }}
                          {%- endif -%}
                        </span>
                        <span class="sold-out-message hidden">
                          {{ 'products.product.sold_out' | t }}
                        </span>
                        {%- render 'loading-spinner' -%}
                      </button>
                    </div>
                  </div>
                  <div class="product-form__error-message-wrapper" role="alert" hidden>
                    <span class="product-form__error-message"></span>
                  </div>
                {%- endform -%}
              </product-form>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </before-after-comparison>
  </div>

  {%- comment -%}
    The quick add dialog is fixed-position, so it has to live outside the media
    panel: that panel clips its overflow and opens its own stacking context.
  {%- endcomment -%}
  {%- if show_product and needs_options -%}
    <quick-add-modal id="{{ product_form_id }}-modal" class="quick-add-modal">
      <div
        role="dialog"
        aria-label="{{ 'products.product.choose_product_options' | t: product_name: featured_product.title | escape }}"
        aria-modal="true"
        class="quick-add-modal__content global-settings-popup"
        tabindex="-1"
      >
        <button
          id="{{ product_form_id }}-modal-close"
          type="button"
          class="quick-add-modal__toggle"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
        <div id="QuickAddInfo-{{ section.id }}-{{ featured_product.id }}" class="quick-add-modal__content-info"></div>
      </div>
    </quick-add-modal>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Before/after comparison",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "See the difference" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Drag the handle to compare the look before and after.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Comparison" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial handle position",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 50
    },

    { "type": "header", "content": "Featured product" },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "Show product on the image",
      "default": true
    },
    { "type": "product", "id": "product", "label": "Product" },
    {
      "type": "paragraph",
      "content": "Products with options open the theme's quick add window so the customer picks a variant before it is added."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "info": "Maximum width of the section on desktop. Narrower screens scale down automatically.",
      "min": 1000,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1700
    },

    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "section_color_scheme", "label": "Section color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Content panel color scheme", "default": "scheme-6" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [{ "name": "Before/after comparison" }]
}
{% endschema %}
