{%- liquid
  assign loading = 'lazy'
  assign fetch_priority = 'auto'
  if section.index <= 2
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif

  # The sizes attribute takes CSS lengths but not custom properties: a var()
  # here is invalid, so the browser fell back to 100vw and pulled the largest
  # source for an image a few dozen pixels wide. The larger of the two image
  # settings is the hint.
  assign image_size = section.settings.image_size | at_least: section.settings.mobile_image_size
  assign image_sizes = image_size | append: 'px'

  # Four columns are too narrow below desktop, so tablets get two.
  assign columns_tablet = section.settings.columns_desktop
  if columns_tablet > 3
    assign columns_tablet = 2
  endif

  case section.settings.alignment
    when 'left'
      assign item_align = 'flex-start'
    when 'right'
      assign item_align = 'flex-end'
    else
      assign item_align = 'center'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .feature-highlights {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_inline }}px {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.text_color }};
    background: {{ section.settings.background }};
  }

  #shopify-section-{{ section.id }} .feature-highlights__heading {
    margin: 0 0 clamp(2.4rem, 3vw, 4rem);
    color: inherit;
    text-align: {{ section.settings.alignment }};
  }

  #shopify-section-{{ section.id }} .feature-highlights__list {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.column_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .feature-highlights__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: {{ item_align }};
    text-align: {{ section.settings.alignment }};
  }

  #shopify-section-{{ section.id }} .feature-highlights__image-wrap {
    display: flex;
    width: {{ section.settings.image_size }}px;
    height: {{ section.settings.image_size }}px;
    margin-bottom: {{ section.settings.image_spacing }}px;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .feature-highlights__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .feature-highlights__title {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.heading_size }}px;
    font-style: var(--font-heading-style);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: normal;
  }

  #shopify-section-{{ section.id }} .feature-highlights__text {
    max-width: 38rem;
    margin-top: .6rem;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .feature-highlights__text > * {
    margin-block: 0;
  }

  #shopify-section-{{ section.id }} .feature-highlights__button {
    margin-top: 2rem;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .feature-highlights__list {
      grid-template-columns: repeat({{ columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .feature-highlights {
      padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_inline }}px {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .feature-highlights__list {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ section.settings.mobile_gap }}px 1.6rem;
    }

    #shopify-section-{{ section.id }} .feature-highlights__image-wrap {
      width: {{ section.settings.mobile_image_size }}px;
      height: {{ section.settings.mobile_image_size }}px;
    }

    #shopify-section-{{ section.id }} .feature-highlights__title {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .feature-highlights__text {
      font-size: {{ section.settings.mobile_text_size }}px;
    }

    #shopify-section-{{ section.id }} .feature-highlights--hide-mobile {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .feature-highlights--hide-desktop {
      display: none;
    }
  }
{%- endstyle -%}

<div class="feature-highlights{% unless section.settings.show_on_desktop %} feature-highlights--hide-desktop{% endunless %}{% unless section.settings.show_on_mobile %} feature-highlights--hide-mobile{% endunless %}">
  {%- if section.settings.heading != blank -%}
    <h2 class="feature-highlights__heading h2 inline-richtext">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="feature-highlights__list" role="list">
      {%- for block in section.blocks -%}
        <li
          class="feature-highlights__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
        >
          {%- if block.settings.image != blank -%}
            <div class="feature-highlights__image-wrap">
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  widths: '60, 90, 120, 180, 240, 320, 400',
                  sizes: image_sizes,
                  loading: loading,
                  fetchpriority: fetch_priority,
                  class: 'feature-highlights__image'
              }}
            </div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="feature-highlights__title inline-richtext">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="feature-highlights__text rte">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a
              class="button{% if block.settings.button_style_secondary %} button--secondary{% endif %} feature-highlights__button"
              {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="center">Add highlight blocks to this section.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Feature highlights",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Optional. Leave empty to show only the items." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3, "info": "Tablets show the same number, or two when this is four." },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "1", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] },
    { "type": "text_alignment", "id": "alignment", "label": "Alignment", "default": "center" },
    { "type": "range", "id": "column_gap", "label": "Space between items on desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_gap", "label": "Space between items on mobile", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 40 },

    { "type": "header", "content": "Image" },
    { "type": "range", "id": "image_size", "label": "Image size on desktop", "min": 32, "max": 200, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "mobile_image_size", "label": "Image size on mobile", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "image_spacing", "label": "Space below image", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 18 },

    { "type": "header", "content": "Text size" },
    { "type": "range", "id": "heading_size", "label": "Item heading on desktop", "min": 14, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_heading_size", "label": "Item heading on mobile", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 21 },
    { "type": "range", "id": "text_size", "label": "Item text on desktop", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_text_size", "label": "Item text on mobile", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FDE6DE" },
    { "type": "color", "id": "text_color", "label": "Text and headings", "default": "#FF4B22" },

    { "type": "header", "content": "Spacing on desktop" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 84 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_inline", "label": "Sides", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 48 },

    { "type": "header", "content": "Spacing on mobile" },
    { "type": "range", "id": "mobile_padding_top", "label": "Top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 68 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "mobile_padding_inline", "label": "Sides", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 30 },

    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop and tablet", "default": true },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image or icon" },
        { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Feature heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a benefit or product detail with your customers.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "button_style_secondary", "label": "Use outline button style", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature highlights",
      "blocks": [
        { "type": "highlight", "settings": { "title": "Soft & Comfortable", "text": "<p>Lightweight fabric made for all-day wear.</p>" } },
        { "type": "highlight", "settings": { "title": "Adventure Ready", "text": "<p>Durable enough for parks, walks, and zoomies.</p>" } },
        { "type": "highlight", "settings": { "title": "Collectable Designs", "text": "<p>New patch drops to keep the style fresh.</p>" } }
      ]
    }
  ]
}
{% endschema %}
