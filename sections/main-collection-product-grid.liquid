{% comment %}
  Collection product grid.

  Owns the whole collection listing: the filter/sort toolbar, the product
  count, the grid itself and its cards. It deliberately renders its own card
  (`collection-product-card`) instead of the shared `card-product` snippet so
  the listing can evolve without touching the product page, search results or
  the homepage sections.

  Stylesheets are loaded before `collection-grid.css` on purpose: the grid's
  own rules override Dawn's facet, rating and pagination defaults, and the
  later sheet wins at equal specificity.
{% endcomment %}

{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'component-pagination.css' | asset_url | stylesheet_tag }}
{{ 'component-show-more.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_rating -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.show_swatches -%}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{{ 'collection-grid.css' | asset_url | stylesheet_tag }}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- unless section.settings.quick_add == 'none' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- liquid
  case section.settings.image_ratio
    when 'portrait'
      assign image_ratio = '3 / 4'
    when 'landscape'
      assign image_ratio = '4 / 3'
    else
      assign image_ratio = '1 / 1'
  endcase

  comment
    The sidebar layout owns its own toolbar; the sidebar column itself only
    exists when there are filters to put in it.
  endcomment
  assign use_sidebar = false
  if section.settings.filter_type == 'vertical'
    assign use_sidebar = true
  endif

  assign show_sidebar_column = false
  if use_sidebar and section.settings.enable_filtering
    assign show_sidebar_column = true
  endif

  assign column_gap_mobile = section.settings.column_gap | times: 0.7 | round: 0
  assign row_gap_mobile = section.settings.row_gap | times: 0.7 | round: 0
  assign content_padding_mobile = section.settings.content_padding | times: 0.5 | round: 0
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --cg-columns: {{ section.settings.columns_desktop }};
    --cg-columns-tablet: {{ section.settings.columns_tablet }};
    --cg-columns-mobile: {{ section.settings.columns_mobile }};
    --cg-column-gap: {{ section.settings.column_gap }}px;
    --cg-row-gap: {{ section.settings.row_gap }}px;
    --cg-column-gap-mobile: {{ column_gap_mobile }}px;
    --cg-row-gap-mobile: {{ row_gap_mobile }}px;
    --cg-block-gap: {{ section.settings.block_gap }}px;
    --cg-content-width: {{ section.settings.content_width }}px;
    --cg-content-padding: {{ section.settings.content_padding }}px;
    --cg-content-padding-mobile: {{ content_padding_mobile }}px;
    --cg-sidebar-width: {{ section.settings.sidebar_width }}px;
    --cg-sidebar-gap: {{ section.settings.sidebar_gap }}px;
    --cg-control-height: {{ section.settings.control_height }}px;
    --cg-control-radius: {{ section.settings.control_radius }}px;
    --cg-card-radius: {{ section.settings.card_radius }}px;
    --cg-card-content-spacing: {{ section.settings.card_content_spacing }}px;
    --cg-image-ratio: {{ image_ratio }};
    --cg-image-fit: {{ section.settings.image_fit }};
    --cg-image-background: {{ section.settings.image_background }};
    --cg-title-size: {{ section.settings.title_size }}px;
    --cg-price-size: {{ section.settings.price_size }}px;
    --cg-compare-price-color: {{ section.settings.compare_price_color }};
    --cg-discount-background: {{ section.settings.discount_pill_background }};
    --cg-discount-text: {{ section.settings.discount_pill_text }};
    --cg-badge-background: {{ section.settings.badge_background }};
    --cg-badge-text: {{ section.settings.badge_text_color }};
    --cg-badge-offset: {{ section.settings.badge_offset }}px;
    --cg-action-height: {{ section.settings.action_height }}px;
    --cg-swatch-size: {{ section.settings.swatch_size }}px;
    --cg-facet-control-size: {{ section.settings.facet_control_size }}px;
    --cg-facet-swatch-size: {{ section.settings.facet_swatch_size }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<collection-component
  class="collection-grid"
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="collection-grid__inner">
        <div class="cg-layout{% if show_sidebar_column %} cg-layout--sidebar{% endif %}">
          {%- comment -%}
            The toolbar is the first child so sorting is the first tabbable
            control, but on desktop the grid places it over the products
            rather than across the page, so the count and the sorting read as
            part of the grid. The drawer layout gets both from the facets
            snippet instead.
          {%- endcomment -%}
          {%- if use_sidebar -%}
            <facet-filters-form class="facets cg-toolbar">
              <form class="cg-toolbar__form" id="FacetSortForm">
                <div class="cg-count" role="status">
                  <h2 class="cg-count__text">
                    <span id="ProductCountDesktop">
                      {%- if collection.results_count -%}
                        {{
                          'templates.search.results_with_count'
                          | t: terms: collection.terms, count: collection.results_count
                        }}
                      {%- elsif collection.products_count == collection.all_products_count -%}
                        {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                      {%- else -%}
                        {{
                          'products.facets.product_count'
                          | t: product_count: collection.products_count, count: collection.all_products_count
                        }}
                      {%- endif -%}
                    </span>
                  </h2>
                  {%- render 'loading-spinner' -%}
                </div>

                {%- if section.settings.enable_sorting -%}
                  <div class="cg-sort">
                    <h2 class="cg-sort__label">
                      <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                    </h2>
                    <div class="cg-sort__field">
                      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                      <select
                        name="sort_by"
                        class="cg-sort__select"
                        id="SortBy"
                        aria-describedby="a11y-refresh-page-message"
                      >
                        {%- for option in collection.sort_options -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              selected="selected"
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                      <span class="cg-sort__caret">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </div>
                  </div>
                {%- endif -%}
              </form>
            </facet-filters-form>
          {%- endif -%}

          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              {% if show_sidebar_column %}
                aria-labelledby="verticalTitle"
              {% else %}
                aria-label="{{ 'products.facets.filter_and_sort' | t }}"
              {% endif %}
              class="{% if use_sidebar %}cg-sidebar{% if section.settings.sticky_filters %} cg-sidebar--sticky{% endif %}{% else %}cg-filterbar{% endif %} facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
              id="main-collection-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: collection,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate,
                color_swatches: true
              %}
            </aside>
          {%- endif -%}

          <div
            class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            id="ProductGridContainer"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- if collection.products.size == 0 -%}
              <div class="collection cg-results" id="product-grid" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div class="cg-empty">
                  <h2 class="cg-empty__title">{{ 'sections.collection_template.empty' | t }}</h2>
                  <p class="cg-empty__text">
                    {{
                      'sections.collection_template.use_fewer_filters_html'
                      | t: link: collection.url, class: 'underlined-link link'
                    }}
                  </p>
                </div>
              </div>
            {%- else -%}
              <div class="collection cg-results">
                <div class="loading-overlay gradient"></div>
                <ul id="product-grid" data-id="{{ section.id }}" class="cg-grid" role="list">
                  {%- for product in collection.products -%}
                    {%- liquid
                      assign lazy_load = 'lazy'
                      if forloop.index <= section.settings.columns_desktop
                        assign lazy_load = 'eager'
                      endif
                    -%}
                    <li
                      class="cg-grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% render 'collection-product-card',
                        product: product,
                        section: section,
                        lazy_load: lazy_load
                      %}
                    </li>
                  {%- endfor -%}
                </ul>

                {%- if paginate.pages > 1 -%}
                  {% render 'pagination', paginate: paginate, anchor: '' %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{% schema %}
{
  "name": "Product grid",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on tablet"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Horizontal spacing between cards",
      "info": "Mobile spacing is scaled down automatically."
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 8,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Vertical spacing between cards"
    },
    {
      "type": "range",
      "id": "block_gap",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28,
      "label": "Spacing between toolbar, grid and pagination"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1100,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400,
      "label": "Maximum content width",
      "info": "The grid shares this width with the filter sidebar, so it can run wider than the theme's page width without the cards turning narrow."
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32,
      "label": "Side padding",
      "info": "Halved on mobile."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "default": "vertical",
      "label": "Filter layout",
      "info": "On screens narrower than 990px both layouts use the drawer.",
      "options": [
        { "value": "vertical", "label": "Sidebar" },
        { "value": "drawer", "label": "Drawer" }
      ]
    },
    {
      "type": "checkbox",
      "id": "sticky_filters",
      "default": true,
      "label": "Keep the sidebar in view while scrolling"
    },
    {
      "type": "range",
      "id": "sidebar_width",
      "min": 180,
      "max": 340,
      "step": 10,
      "unit": "px",
      "default": 240,
      "label": "Sidebar width"
    },
    {
      "type": "range",
      "id": "sidebar_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32,
      "label": "Space between sidebar and grid"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "range",
      "id": "control_height",
      "min": 32,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 40,
      "label": "Sort and filter button height"
    },
    {
      "type": "range",
      "id": "control_radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Sort and filter button corner radius"
    },
    {
      "type": "range",
      "id": "facet_control_size",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Filter selection circle size"
    },
    {
      "type": "range",
      "id": "facet_swatch_size",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28,
      "label": "Filter colour swatch size"
    },
    {
      "type": "header",
      "content": "Card image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "default": "portrait",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "default": "contain",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Fit whole image" },
        { "value": "cover", "label": "Fill the frame" }
      ]
    },
    {
      "type": "color",
      "id": "image_background",
      "default": "#f0f3f5",
      "label": "Image background"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Card corner radius"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show second image on hover"
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "range",
      "id": "card_content_spacing",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Space between image and text"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Title size"
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Price size"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "default": true,
      "label": "Show colour swatches"
    },
    {
      "type": "text",
      "id": "color_option_name",
      "default": "Color",
      "label": "Colour option name",
      "info": "Must match the product option name exactly."
    },
    {
      "type": "range",
      "id": "swatches_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Swatches to show"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Swatch size"
    },
    {
      "type": "header",
      "content": "Badges and price"
    },
    {
      "type": "checkbox",
      "id": "show_sold_out_badge",
      "default": true,
      "label": "Show sold out badge"
    },
    {
      "type": "checkbox",
      "id": "show_custom_badge",
      "default": false,
      "label": "Show custom badge",
      "info": "Uses the product's custom.card_badge metafield."
    },
    {
      "type": "color",
      "id": "badge_background",
      "default": "#7961d7",
      "label": "Custom badge background"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "default": "#ffffff",
      "label": "Custom badge text"
    },
    {
      "type": "range",
      "id": "badge_offset",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "Badge and button inset"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "default": true,
      "label": "Show discount pill next to the price"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "default": "#8a93a0",
      "label": "Compare-at price colour"
    },
    {
      "type": "color",
      "id": "discount_pill_background",
      "default": "#ff0000",
      "label": "Discount pill background"
    },
    {
      "type": "color",
      "id": "discount_pill_text",
      "default": "#ffffff",
      "label": "Discount pill text"
    },
    {
      "type": "header",
      "content": "Add to cart"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "button",
      "label": "Card action",
      "info": "Products that still need a variant chosen show \"Choose options\" and open a dialog — they are never added straight to the cart.",
      "options": [
        { "value": "none", "label": "Hidden" },
        { "value": "button", "label": "Button under the price" }
      ]
    },
    {
      "type": "range",
      "id": "action_height",
      "min": 32,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 40,
      "label": "Button height"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
