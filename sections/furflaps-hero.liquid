{{ 'furflaps-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furflaps-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign fetch_priority = 'auto'
  assign loading = 'lazy'
  if section.index == 1
    assign fetch_priority = 'high'
    assign loading = 'eager'
  endif
-%}

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --ff-desktop-height: {{ section.settings.desktop_height }};
    --ff-mobile-height: {{ section.settings.mobile_height }};
    --ff-content-padding-vertical: {{ section.settings.content_padding_vertical }}px;
    --ff-content-padding-horizontal: {{ section.settings.content_padding_horizontal }}px;
    --ff-mobile-content-padding-vertical: {{ section.settings.mobile_content_padding_vertical }}px;
    --ff-mobile-content-padding-horizontal: {{ section.settings.mobile_content_padding_horizontal }}px;
    --ff-content-max-width: {{ section.settings.content_max_width }}px;
    --ff-heading-font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --ff-heading-font-style: {{ section.settings.heading_font.style }};
    --ff-heading-weight: {{ section.settings.heading_font.weight }};
    --ff-heading-size: {{ section.settings.heading_size }}px;
    --ff-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --ff-body-font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --ff-body-font-style: {{ section.settings.body_font.style }};
    --ff-body-weight: {{ section.settings.body_font.weight }};
    --ff-body-size: {{ section.settings.body_size }}px;
    --ff-mobile-body-size: {{ section.settings.mobile_body_size }}px;
    --ff-description-spacing: {{ section.settings.description_spacing }}px;
    --ff-button-spacing: {{ section.settings.button_spacing }}px;
    --ff-button-radius: {{ section.settings.button_radius }}px;
    --ff-indicator-active: {{ section.settings.indicator_active_color }};
    --ff-image-position: {{ section.settings.image_position }};
    --ff-mobile-image-position: {{ section.settings.mobile_image_position }};
    --ff-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<furflaps-hero
  class="furflaps-hero furflaps-hero--text-{{ section.settings.content_alignment }}{% if section.settings.heading_uppercase %} furflaps-hero--uppercase{% endif %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay }}"
>
  <div class="furflaps-hero__grid">
    <div class="furflaps-hero__content">
      <div
        class="furflaps-hero__track"
        data-hero-track
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="Featured promotions"
      >
        {%- for block in section.blocks -%}
          <article
            class="furflaps-hero__slide furflaps-hero__slide--{{ section.settings.content_position }} furflaps-hero__slide--align-{{ section.settings.content_alignment }}"
            data-hero-slide
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            style="
              --ff-slide-heading: {{ block.settings.heading_color }};
              --ff-slide-text: {{ block.settings.text_color }};
              --ff-slide-button-background: {{ block.settings.button_background }};
              --ff-slide-button-text: {{ block.settings.button_text_color }};
            "
            {{ block.shopify_attributes }}
          >
            <div class="furflaps-hero__slide-inner">
              {%- if block.settings.heading != blank -%}
                <h2 class="furflaps-hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="furflaps-hero__description rte">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <div class="furflaps-hero__actions">
                  <a
                    class="furflaps-hero__button"
                    {% if block.settings.button_link != blank %}
                      href="{{ block.settings.button_link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                  >
                    <span>{{ block.settings.button_label | escape }}</span>
                    {%- if section.settings.show_button_icon -%}
                      <svg class="furflaps-hero__button-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3.5 12.5 12.5 3.5M6 3.5h6.5V10" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- endif -%}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 and section.settings.show_pagination -%}
        <div class="furflaps-hero__pagination" aria-label="Choose a promotion">
          {%- for block in section.blocks -%}
            <button
              class="furflaps-hero__indicator"
              type="button"
              data-hero-indicator="{{ forloop.index0 }}"
              aria-label="Go to promotion {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="furflaps-hero__media">
      {%- if desktop_image != blank -%}
        <picture>
          {%- if mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 375 }} 375w,
                {{ mobile_image | image_url: width: 550 }} 550w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            desktop_image
            | image_url: width: 2400
            | image_tag:
              class: 'furflaps-hero__image',
              widths: '550, 750, 1100, 1500, 2000, 2400',
              sizes: '100vw',
              loading: loading,
              fetchpriority: fetch_priority
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'furflaps-hero__placeholder' }}
      {%- endif -%}
    </div>
  </div>
</furflaps-hero>

{% schema %}
{
  "name": "Furflaps hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Optional. Uses the desktop image when empty." },
    {
      "type": "select", "id": "image_position", "label": "Desktop focal point", "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Center right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "select", "id": "mobile_image_position", "label": "Mobile focal point", "default": "center center",
      "options": [
        { "value": "left center", "label": "Left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "range", "id": "overlay_opacity", "label": "Image shade behind the text", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 25,
      "info": "Darkens the image from the text side so the words stay readable."
    },
    { "type": "header", "content": "Height" },
    {
      "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 25, "max": 100, "step": 1, "unit": "%", "default": 50,
      "info": "Height as a share of the section width. 50% = half as tall as it is wide."
    },
    {
      "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 60, "max": 200, "step": 5, "unit": "%", "default": 100,
      "info": "Height as a share of the screen width. 100% = square."
    },
    { "type": "header", "content": "Content" },
    {
      "type": "select", "id": "content_alignment", "label": "Alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select", "id": "content_position", "label": "Vertical position", "default": "center",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    { "type": "range", "id": "content_max_width", "label": "Maximum text width", "min": 300, "max": 900, "step": 10, "unit": "px", "default": 670 },
    { "type": "range", "id": "content_padding_horizontal", "label": "Desktop side padding", "min": 16, "max": 160, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "content_padding_vertical", "label": "Desktop top/bottom padding", "min": 16, "max": 160, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_content_padding_horizontal", "label": "Mobile side padding", "min": 12, "max": 80, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_content_padding_vertical", "label": "Mobile top/bottom padding", "min": 12, "max": 100, "step": 2, "unit": "px", "default": 30 },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "oswald_n5" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 110, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 38 },
    { "type": "checkbox", "id": "heading_uppercase", "label": "Heading in capitals", "default": true },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_body_size", "label": "Mobile body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "description_spacing", "label": "Space under heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 14 },
    { "type": "header", "content": "Button" },
    { "type": "range", "id": "button_spacing", "label": "Space above button", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "button_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "show_button_icon", "label": "Show button arrow", "default": true },
    { "type": "header", "content": "Slider", "info": "Only shown when there are 2 or more slides." },
    { "type": "checkbox", "id": "show_pagination", "label": "Show pagination", "default": true },
    { "type": "color", "id": "indicator_active_color", "label": "Active indicator color", "default": "#7D0501" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": false },
    { "type": "range", "id": "autoplay_delay", "label": "Auto-rotate delay", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Content slide",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Made for them. Personalized by you." },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Personalized collars made for cats and dogs, with playful colours, custom names, and a style that's uniquely theirs.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Colors" },
        { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
        { "type": "color", "id": "text_color", "label": "Description", "default": "#FFFFFF" },
        { "type": "color", "id": "button_background", "label": "Button background", "default": "#CC302A" },
        { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Furflaps hero",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
