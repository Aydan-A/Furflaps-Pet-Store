    { "type": "range", "id": "mobile_pagination_offset_vertical", "label": "Mobile top offset", "min": 10, "max": 80, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_pagination_offset_horizontal", "label": "Mobile side offset", "min": 10, "max": 80, "step": 2, "unit": "px", "default": 24 },
