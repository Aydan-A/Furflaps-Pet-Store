    { "type": "range", "id": "mobile_button_padding", "label": "Mobile horizontal padding", "min": 12, "max": 50, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "button_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "button_border_width", "label": "Border width", "min": 0, "max": 5, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_font_size", "label": "Font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
