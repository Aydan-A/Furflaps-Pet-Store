{{ 'split-image-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'split-image-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --sis-section-padding-top: {{ section.settings.padding_top }}px;
    --sis-section-padding-inline: {{ section.settings.padding_inline }}px;
    --sis-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sis-mobile-section-padding-top: {{ section.settings.mobile_padding_top }}px;
    --sis-mobile-section-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    --sis-mobile-section-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --sis-desktop-height: {{ section.settings.desktop_height }}px;
    --sis-mobile-content-height: {{ section.settings.mobile_content_height }}px;
    --sis-mobile-media-height: {{ section.settings.mobile_media_height }}px;
    --sis-content-ratio: {{ section.settings.content_width }}fr;
    --sis-media-ratio: {{ 100 | minus: section.settings.content_width }}fr;
    --sis-panel-gap: {{ section.settings.panel_gap }}px;
    --sis-mobile-panel-gap: {{ section.settings.mobile_panel_gap }}px;
    --sis-panel-radius: {{ section.settings.panel_radius }}px;
    --sis-mobile-panel-radius: {{ section.settings.mobile_panel_radius }}px;
    --sis-content-padding-vertical: {{ section.settings.content_padding_vertical }}px;
    --sis-content-padding-horizontal: {{ section.settings.content_padding_horizontal }}px;
    --sis-mobile-content-padding-vertical: {{ section.settings.mobile_content_padding_vertical }}px;
    --sis-mobile-content-padding-horizontal: {{ section.settings.mobile_content_padding_horizontal }}px;
    --sis-mobile-description-spacing: {{ section.settings.mobile_description_spacing }}px;
    --sis-mobile-button-spacing: {{ section.settings.mobile_button_spacing }}px;
    --sis-content-max-width: {{ section.settings.content_max_width }}px;
    --sis-heading-font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --sis-heading-font-style: {{ section.settings.heading_font.style }};
    --sis-heading-size: {{ section.settings.heading_size }}px;
    --sis-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --sis-heading-weight: {{ section.settings.heading_weight }};
    --sis-heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --sis-heading-letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 10.0 }}px;
    --sis-body-font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --sis-body-font-style: {{ section.settings.body_font.style }};
    --sis-body-size: {{ section.settings.body_size }}px;
    --sis-mobile-body-size: {{ section.settings.mobile_body_size }}px;
    --sis-body-weight: {{ section.settings.body_weight }};
    --sis-body-line-height: {{ section.settings.body_line_height | divided_by: 100.0 }};
    --sis-body-letter-spacing: {{ section.settings.body_letter_spacing | divided_by: 10.0 }}px;
    --sis-description-spacing: {{ section.settings.description_spacing }}px;
    --sis-button-spacing: {{ section.settings.button_spacing }}px;
    --sis-button-height: {{ section.settings.button_height }}px;
    --sis-mobile-button-height: {{ section.settings.mobile_button_height }}px;
    --sis-button-padding: {{ section.settings.button_padding }}px;
    --sis-mobile-button-padding: {{ section.settings.mobile_button_padding }}px;
    --sis-button-radius: {{ section.settings.button_radius }}px;
    --sis-button-border-width: {{ section.settings.button_border_width }}px;
    --sis-button-font-size: {{ section.settings.button_font_size }}px;
    --sis-mobile-button-font-size: {{ section.settings.mobile_button_font_size }}px;
    --sis-button-font-weight: {{ section.settings.button_font_weight }};
    --sis-button-icon-gap: {{ section.settings.button_icon_gap }}px;
    --sis-button-icon-size: {{ section.settings.button_icon_size }}px;
    --sis-pagination-offset-vertical: {{ section.settings.pagination_offset_vertical }}px;
    --sis-pagination-offset-horizontal: {{ section.settings.pagination_offset_horizontal }}px;
    --sis-mobile-pagination-offset-vertical: {{ section.settings.mobile_pagination_offset_vertical }}px;
    --sis-mobile-pagination-offset-horizontal: {{ section.settings.mobile_pagination_offset_horizontal }}px;
    --sis-indicator-width: {{ section.settings.indicator_width }}px;
    --sis-indicator-height: {{ section.settings.indicator_height }}px;
    --sis-indicator-gap: {{ section.settings.indicator_gap }}px;
    --sis-indicator-radius: {{ section.settings.indicator_radius }}px;
    --sis-indicator-border-width: {{ section.settings.indicator_border_width }}px;
    --sis-indicator-background: {{ section.settings.indicator_color }};
    --sis-indicator-border: {{ section.settings.indicator_border_color }};
    --sis-indicator-active: {{ section.settings.indicator_active_color }};
    --sis-media-background: {{ section.settings.media_background }};
    --sis-image-fit: {{ section.settings.image_fit }};
    --sis-image-position: {{ section.settings.image_position }};
  }
{%- endstyle -%}

<split-image-slider
  class="split-image-slider"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay }}"
>
  <div class="split-image-slider__grid{% if section.settings.mobile_panel_order == 'media_first' %} split-image-slider__grid--media-first{% endif %}">
    <div class="split-image-slider__content">
      <div
        class="split-image-slider__track"
        data-hero-track
      >
        {%- for block in section.blocks limit: 1 -%}
          {%- liquid
            assign button_link = section.settings.button_link
            if button_link == blank and section.settings.product != blank
              assign button_link = section.settings.product.url
            elsif button_link == blank and section.settings.collection != blank
              assign button_link = section.settings.collection.url
            elsif button_link == blank and section.settings.page != blank
              assign button_link = section.settings.page.url
            endif
          -%}
          <article
            class="split-image-slider__slide split-image-slider__slide--{{ section.settings.content_position }} split-image-slider__slide--align-{{ section.settings.content_alignment }}"
            data-hero-slide
            style="
              --sis-slide-background: {{ section.settings.background_color }};
              --sis-slide-heading: {{ section.settings.heading_color }};
              --sis-slide-text: {{ section.settings.text_color }};
              --sis-slide-button-background: {{ section.settings.button_background }};
              --sis-slide-button-text: {{ section.settings.button_text_color }};
              --sis-slide-button-border: {{ section.settings.button_border_color }};
            "
          >
            <div class="split-image-slider__slide-inner">
              {%- if section.settings.heading != blank -%}
                <h2 class="split-image-slider__heading">{{ section.settings.heading }}</h2>
              {%- endif -%}

              {%- if section.settings.description != blank -%}
                <div class="split-image-slider__description rte">{{ section.settings.description }}</div>
              {%- endif -%}

              {%- if section.settings.button_label != blank -%}
                <div class="split-image-slider__actions">
                  <a
                    class="split-image-slider__button"
                    {% if button_link != blank %}
                      href="{{ button_link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                  >
                    <span>{{ section.settings.button_label | escape }}</span>
                    {%- if section.settings.show_button_icon -%}
                      <svg class="split-image-slider__button-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3.5 12.5 12.5 3.5M6 3.5h6.5V10" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- endif -%}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 and section.settings.show_pagination -%}
        <div class="split-image-slider__pagination split-image-slider__pagination--{{ section.settings.pagination_alignment }}" aria-label="{{ section.settings.pagination_label | escape }}">
          {%- for block in section.blocks -%}
            <button
              class="split-image-slider__indicator"
              type="button"
              data-hero-indicator="{{ forloop.index0 }}"
              aria-label="{{ section.settings.pagination_item_label | escape }} {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="split-image-slider__media">
      <div
        class="split-image-slider__media-track"
        data-hero-media-track
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.media_accessibility_label | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign desktop_image = block.settings.image | default: section.settings.image
            assign mobile_image = block.settings.mobile_image | default: desktop_image
            assign loading = 'lazy'
            assign fetch_priority = 'auto'
            if section.index == 1 and forloop.first
              assign loading = 'eager'
              assign fetch_priority = 'high'
            endif
          -%}
          <figure
            class="split-image-slider__media-slide"
            data-hero-media-slide
            role="group"
            aria-roledescription="slide"
            aria-label="{{ block.settings.slide_label | default: section.settings.pagination_item_label | escape }}, {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            {{ block.shopify_attributes }}
          >
            {%- if desktop_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 375 }} 375w,
                      {{ mobile_image | image_url: width: 550 }} 550w,
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 1100 }} 1100w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}
                {{
                  desktop_image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'split-image-slider__image',
                    widths: '550, 750, 1100, 1500, 2000, 2400',
                    sizes: '(min-width: 990px) 60vw, (min-width: 750px) 50vw, 100vw',
                    loading: loading,
                    fetchpriority: fetch_priority
                }}
              </picture>
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'split-image-slider__placeholder' }}
            {%- endif -%}

            {%- if block.settings.image_caption != blank -%}
              <figcaption class="split-image-slider__caption rte">{{ block.settings.image_caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
</split-image-slider>

{% schema %}
{
  "name": "Split image slider",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Upgrade their everyday look" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Add your promotional message here.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "product", "id": "product", "label": "Fallback button product" },
    { "type": "collection", "id": "collection", "label": "Fallback button collection" },
    { "type": "page", "id": "page", "label": "Fallback button page" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F44316" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Description", "default": "#FFFFFF" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#111111" },
    { "type": "color", "id": "button_border_color", "label": "Button border", "default": "#FFFFFF" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "color", "id": "media_background", "label": "Media placeholder background", "default": "#D9E7F2" },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Center right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "desktop_height", "label": "Height", "min": 360, "max": 900, "step": 10, "unit": "px", "default": 600 },
    { "type": "range", "id": "content_width", "label": "Content panel width", "min": 30, "max": 70, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "panel_gap", "label": "Panel gap", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "panel_radius", "label": "Panel corner radius", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "content_max_width", "label": "Content maximum width", "min": 240, "max": 800, "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "content_padding_vertical", "label": "Content vertical padding", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "content_padding_horizontal", "label": "Content horizontal padding", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 64 },
    {
      "type": "select", "id": "content_position", "label": "Content vertical position", "default": "center",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Mobile layout" },
    { "type": "range", "id": "mobile_content_height", "label": "Content panel height", "min": 280, "max": 700, "step": 10, "unit": "px", "default": 340 },
    { "type": "range", "id": "mobile_media_height", "label": "Media panel height", "min": 240, "max": 700, "step": 10, "unit": "px", "default": 320 },
    { "type": "range", "id": "mobile_panel_gap", "label": "Panel gap", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "mobile_panel_radius", "label": "Panel corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "mobile_content_padding_vertical", "label": "Content vertical padding", "min": 16, "max": 100, "step": 2, "unit": "px", "default": 38 },
    { "type": "range", "id": "mobile_content_padding_horizontal", "label": "Content horizontal padding", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_description_spacing", "label": "Heading-to-description spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_button_spacing", "label": "Spacing above button", "min": 0, "max": 50, "step": 2, "unit": "px", "default": 20 },
    {
      "type": "select", "id": "mobile_panel_order", "label": "Panel order", "default": "content_first",
      "options": [
        { "value": "content_first", "label": "Content first" },
        { "value": "media_first", "label": "Media first" }
      ]
    },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n7" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 96, "step": 1, "unit": "px", "default": 52 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 22, "max": 60, "step": 1, "unit": "px", "default": 32 },
    {
      "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 80, "max": 160, "step": 5, "unit": "%", "default": 105 },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing (tenths of a pixel)", "min": -20, "max": 40, "step": 1, "default": -5 },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_body_size", "label": "Mobile body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    {
      "type": "select", "id": "body_weight", "label": "Body weight", "default": "400",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    { "type": "range", "id": "body_line_height", "label": "Body line height", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 140 },
    { "type": "range", "id": "body_letter_spacing", "label": "Body letter spacing (tenths of a pixel)", "min": -10, "max": 30, "step": 1, "default": 0 },
    { "type": "range", "id": "description_spacing", "label": "Heading-to-description spacing", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 20 },
    { "type": "header", "content": "Button" },
    { "type": "range", "id": "button_spacing", "label": "Spacing above button", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 28 },
