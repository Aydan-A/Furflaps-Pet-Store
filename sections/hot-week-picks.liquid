{% comment %}Hot week picks section{% endcomment %}
{%- if section.settings.show_swatches -%}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{{ 'hot-week-picks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hot-week-picks.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.show_add_to_cart -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign first_tab_active = true
  if section.settings.default_tab == 'new_arrivals'
    assign first_tab_active = false
  endif
-%}

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- if section.settings.custom_card_font -%}
    {{ section.settings.card_font | font_face: font_display: 'swap' }}
    {%- assign card_font_bold = section.settings.card_font | font_modify: 'weight', 'bold' -%}
    {{ card_font_bold | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- assign font_elements = 'title,price' | split: ',' -%}
  {%- for el in font_elements -%}
    {%- assign use_key = 'custom_' | append: el | append: '_font' -%}
    {%- assign font_key = el | append: '_font' -%}
    {%- if section.settings[use_key] -%}
      {{ section.settings[font_key] | font_face: font_display: 'swap' }}
      {%- assign el_font_bold = section.settings[font_key] | font_modify: 'weight', 'bold' -%}
      {{ el_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endfor -%}

  #shopify-section-{{ section.id }} {
    --hot-section-background: {{ section.settings.background_color }};
    --hot-text-color: {{ section.settings.text_color }};
    --hot-image-background: {{ section.settings.image_background }};
    --hot-tab-active-background: {{ section.settings.tab_active_background }};
    --hot-tab-active-text: {{ section.settings.tab_active_text }};
    --hot-tab-text: {{ section.settings.tab_text }};
    --hot-description-color: {{ section.settings.description_color }};
    --hot-compare-price-color: var(--ff-compare-price-color);
    --hot-discount-pill-background: var(--ff-discount-background);
    --hot-discount-pill-text: var(--ff-discount-text);
    --hot-badge-background: var(--ff-badge-background);
    --hot-badge-text: var(--ff-badge-text);
    --hot-margin-top: {{ section.settings.margin_top }}px;
    --hot-margin-bottom: {{ section.settings.margin_bottom }}px;
    --hot-mobile-margin-top: {{ section.settings.mobile_margin_top }}px;
    --hot-mobile-margin-bottom: {{ section.settings.mobile_margin_bottom }}px;
    --hot-padding-top: {{ section.settings.padding_top }}px;
    --hot-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hot-padding-inline: {{ section.settings.padding_inline }}px;
    --hot-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --hot-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --hot-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;
    --hot-header-spacing: {{ section.settings.header_spacing }}px;
    --hot-card-gap: {{ section.settings.card_gap }}px;
    --hot-card-radius: {{ section.settings.card_radius }}px;
    --hot-card-content-spacing: {{ section.settings.card_content_spacing }}px;
    --hot-badge-offset: {{ section.settings.badge_offset }}px;
    --hot-columns: {{ section.settings.columns_desktop }};
    --hot-columns-tablet: {{ section.settings.columns_tablet }};
    --hot-columns-mobile: {{ section.settings.columns_mobile }};
    --hot-image-fit: {{ section.settings.image_fit }};
    --hot-heading-font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --hot-heading-font-style: {{ section.settings.heading_font.style }};
    --hot-heading-size: {{ section.settings.heading_size }}px;
    --hot-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --hot-heading-weight: {{ section.settings.heading_weight }};
    --hot-heading-letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 10.0 }}px;
    --hot-product-title-size: {{ section.settings.product_title_size }}px;
    --hot-price-size: {{ section.settings.price_size }}px;
    --hot-mobile-product-title-size: {{ section.settings.mobile_product_title_size }}px;
    --hot-mobile-price-size: {{ section.settings.mobile_price_size }}px;
    --hot-title-weight: {{ section.settings.product_title_weight }};
    --hot-title-line-height: {{ section.settings.product_title_line_height | divided_by: 100.0 }};
    --hot-title-letter-spacing: {{ section.settings.product_title_letter_spacing | divided_by: 10.0 }}px;
    --hot-title-transform: {% if section.settings.product_title_uppercase %}uppercase{% else %}none{% endif %};
    --hot-price-weight: {{ section.settings.price_weight }};
    {%- if section.settings.custom_card_font %}
    --hot-card-font-family: {{ section.settings.card_font.family }}, {{ section.settings.card_font.fallback_families }};
    --hot-card-font-style: {{ section.settings.card_font.style }};
    {%- endif %}
    {%- if section.settings.custom_title_font %}
    --hot-title-font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    --hot-title-font-style: {{ section.settings.title_font.style }};
    {%- endif %}
    {%- if section.settings.custom_price_font %}
    --hot-price-font-family: {{ section.settings.price_font.family }}, {{ section.settings.price_font.fallback_families }};
    --hot-price-font-style: {{ section.settings.price_font.style }};
    {%- endif %}
    --hot-price-letter-spacing: {{ section.settings.price_letter_spacing | divided_by: 10.0 }}px;
    --hot-card-height: {{ section.settings.card_height }}px;
    --hot-mobile-card-height: {{ section.settings.mobile_card_height }}px;
    --hot-tab-font-size: {{ section.settings.tab_font_size }}px;
    --hot-tab-height: {{ section.settings.tab_height }}px;
    --hot-tab-padding: {{ section.settings.tab_padding }}px;
    --hot-tab-radius: {{ section.settings.tab_radius }}px;
    --hot-tab-gap: {{ section.settings.tab_gap }}px;
    --hot-arrow-size: {{ section.settings.arrow_size }}px;
    --hot-arrow-background: {{ section.settings.arrow_background }};
    --hot-arrow-icon: {{ section.settings.arrow_icon_color }};
    --hot-arrow-border: {{ section.settings.arrow_border_color }};
    --hot-swatch-size: {{ section.settings.swatch_size }}px;
    --hot-cart-size: {{ section.settings.cart_button_size }}px;
    --hot-cart-background: {{ section.settings.cart_button_background }};
    --hot-cart-icon: {{ section.settings.cart_button_icon_color }};
  }
{%- endstyle -%}

<hot-week-picks class="hot-week-picks">
  <div class="hot-week-picks__inner">
    <div class="hot-week-picks__header">
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <h2 class="hot-week-picks__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="hot-week-picks__controls">
        {%- if section.settings.show_tabs -%}
          <div class="hot-week-picks__tabs" role="tablist" aria-label="{{ section.settings.tabs_accessibility_label | escape }}">
            <button
              class="hot-week-picks__tab"
              id="HotTab-{{ section.id }}-best"
              type="button"
              role="tab"
              aria-selected="{% if first_tab_active %}true{% else %}false{% endif %}"
              aria-controls="HotPanel-{{ section.id }}-best"
              tabindex="{% if first_tab_active %}0{% else %}-1{% endif %}"
            >
              {{ section.settings.best_sellers_label | escape }}
            </button>
            <button
              class="hot-week-picks__tab"
              id="HotTab-{{ section.id }}-new"
              type="button"
              role="tab"
              aria-selected="{% unless first_tab_active %}true{% else %}false{% endunless %}"
              aria-controls="HotPanel-{{ section.id }}-new"
              tabindex="{% unless first_tab_active %}0{% else %}-1{% endunless %}"
            >
              {{ section.settings.new_arrivals_label | escape }}
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_arrows -%}
          <div class="hot-week-picks__nav" data-nav>
            <button
              class="hot-week-picks__arrow"
              type="button"
              data-direction="prev"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              class="hot-week-picks__arrow"
              type="button"
              data-direction="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- for tab_index in (1..2) -%}
      {%- liquid
        if tab_index == 1
          assign tab_key = 'best'
          assign tab_collection = section.settings.best_sellers_collection
          assign panel_is_active = first_tab_active
        else
          assign tab_key = 'new'
          assign tab_collection = section.settings.new_arrivals_collection
          assign panel_is_active = false
          unless first_tab_active
            assign panel_is_active = true
          endunless
        endif
      -%}
      <div
        class="hot-week-picks__panel"
        id="HotPanel-{{ section.id }}-{{ tab_key }}"
        role="tabpanel"
        aria-labelledby="HotTab-{{ section.id }}-{{ tab_key }}"
        tabindex="0"
        {% unless panel_is_active or section.settings.show_tabs == false %}hidden{% endunless %}
      >
        {%- liquid
          # A row only shows the next card peeking past the edge when there is
          # a next card. Below the mobile column count the row still fills the
          # width, so a short collection does not end in a stray gap.
          assign shown_count = tab_collection.products_count
          if shown_count > section.settings.products_to_show
            assign shown_count = section.settings.products_to_show
          endif
          assign mobile_columns = section.settings.columns_mobile | plus: 0
          if mobile_columns < 1
            assign mobile_columns = 1
          endif
        -%}
        {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
          <ul class="hot-week-picks__products{% if shown_count > mobile_columns %} hot-week-picks__products--peek{% endif %}" role="list">
            {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
              <li class="hot-week-picks__product">
                {% render 'hot-week-picks-card',
                  product: product,
                  section: section,
                  tab_key: tab_key,
                  lazy_load: 'lazy'
                %}
              </li>
            {%- endfor -%}
          </ul>
          {%- comment -%}
            Phone-only swipe affordance; the scroll arrows are hidden at that
            width. Hidden until the script measures a row that actually scrolls,
            and decorative, so it is out of the accessibility tree entirely.
          {%- endcomment -%}
          <div class="hot-week-picks__progress" data-progress aria-hidden="true" hidden>
            <span></span>
          </div>
        {%- else -%}
          <div class="hot-week-picks__empty">
            {%- if request.design_mode -%}
              Select a collection for this tab in the Theme Editor.
            {%- else -%}
              {{ 'sections.collection_template.empty' | t }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</hot-week-picks>

{% schema %}
{
  "name": "Hot week picks",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hot This Week" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show tabs", "default": true },
    { "type": "collection", "id": "best_sellers_collection", "label": "Best sellers collection" },
    { "type": "text", "id": "best_sellers_label", "label": "Tab 1 label", "default": "Best Sellers" },
    { "type": "collection", "id": "new_arrivals_collection", "label": "New arrivals collection" },
    { "type": "text", "id": "new_arrivals_label", "label": "Tab 2 label", "default": "New Arrivals" },
    {
      "type": "select", "id": "default_tab", "label": "Default active tab", "default": "best_sellers",
      "options": [
        { "value": "best_sellers", "label": "Best sellers" },
        { "value": "new_arrivals", "label": "New arrivals" }
      ]
    },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 2, "max": 20, "step": 1, "default": 8 },
    { "type": "text", "id": "tabs_accessibility_label", "label": "Tabs accessibility label", "default": "Product collections" },

    { "type": "header", "content": "Product cards" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop products per row", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Tablet products per row", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Mobile products per row", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_content_spacing", "label": "Space below image", "min": 4, "max": 30, "step": 1, "unit": "px", "default": 12 },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ]
    },
    { "type": "range", "id": "card_height", "label": "Desktop card height", "min": 300, "max": 700, "step": 4, "unit": "px", "default": 464 },
    { "type": "range", "id": "mobile_card_height", "label": "Mobile card height", "min": 300, "max": 700, "step": 4, "unit": "px", "default": 464 },
    { "type": "paragraph", "content": "The image shrinks or grows to fill whatever height the text leaves." },

    { "type": "header", "content": "Card text" },
    { "type": "checkbox", "id": "custom_card_font", "label": "Use a custom card font", "default": false, "info": "Off = the theme body font." },
    { "type": "font_picker", "id": "card_font", "label": "Card font", "default": "assistant_n4", "visible_if": "{{ section.settings.custom_card_font }}" },
    { "type": "checkbox", "id": "custom_title_font", "label": "Use a separate product title font", "default": false },
    { "type": "font_picker", "id": "title_font", "label": "Product title font", "default": "assistant_n4", "visible_if": "{{ section.settings.custom_title_font }}" },
    { "type": "range", "id": "product_title_size", "label": "Product title size", "min": 11, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_product_title_size", "label": "Mobile product title size", "min": 11, "max": 28, "step": 1, "unit": "px", "default": 18 },
    {
      "type": "select", "id": "product_title_weight", "label": "Product title weight", "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "range", "id": "product_title_line_height", "label": "Product title line height", "min": 100, "max": 180, "step": 5, "unit": "%", "default": 130 },
    { "type": "range", "id": "product_title_letter_spacing", "label": "Product title letter spacing", "min": -10, "max": 20, "step": 1, "unit": "px", "default": 0, "info": "In tenths of a pixel." },
    { "type": "checkbox", "id": "product_title_uppercase", "label": "Uppercase product title", "default": false },
    { "type": "checkbox", "id": "custom_price_font", "label": "Use a separate price font", "default": false },
    { "type": "font_picker", "id": "price_font", "label": "Price font", "default": "assistant_n4", "visible_if": "{{ section.settings.custom_price_font }}" },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 11, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_price_size", "label": "Mobile price size", "min": 11, "max": 28, "step": 1, "unit": "px", "default": 18 },
    {
      "type": "select", "id": "price_weight", "label": "Price weight", "default": "700",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "range", "id": "price_letter_spacing", "label": "Price letter spacing", "min": -10, "max": 20, "step": 1, "unit": "px", "default": 0, "info": "In tenths of a pixel." },

    { "type": "header", "content": "Badge" },
    { "type": "checkbox", "id": "show_metafield_badge", "label": "Show New / Pre-order product badge", "default": false },
    { "type": "paragraph", "content": "Uses the product metafield custom.card_badge automatically." },
    { "type": "range", "id": "badge_offset", "label": "Badge inset", "min": 4, "max": 24, "step": 1, "unit": "px", "default": 10 },

    { "type": "header", "content": "Discount badge" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount badge (auto-calculated)", "default": true },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n7" },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 20, "max": 64, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 18, "max": 44, "step": 1, "unit": "px", "default": 28 },
    {
      "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "700",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ]
    },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading letter spacing", "min": -10, "max": 10, "step": 1, "unit": "px", "default": -3 },
    { "type": "range", "id": "tab_font_size", "label": "Tab font size", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Colour swatches" },
    { "type": "checkbox", "id": "show_swatches", "label": "Show colour options", "default": true, "info": "Shown under the product title as radio buttons. Choosing a colour switches the card image and link to that variant." },
    { "type": "text", "id": "color_option_name", "label": "Colour option name", "default": "Color", "info": "Must match the product option name. Values without a Shopify swatch fall back to the product's custom.color colours." },
    { "type": "range", "id": "swatches_to_show", "label": "Swatches to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "swatch_size", "label": "Swatch size", "min": 10, "max": 24, "step": 2, "unit": "px", "default": 14 },
    { "type": "color", "id": "description_color", "label": "\"+N more\" text", "default": "#6E7787" },

    { "type": "header", "content": "Add to cart" },
    { "type": "checkbox", "id": "show_add_to_cart", "label": "Show add to cart button", "default": true },
    { "type": "paragraph", "content": "Products with several variants link to the product page instead, so shoppers can choose their options." },
    { "type": "range", "id": "cart_button_size", "label": "Button size", "min": 32, "max": 56, "step": 4, "unit": "px", "default": 40 },
    { "type": "color", "id": "cart_button_background", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "cart_button_icon_color", "label": "Button icon", "default": "#111111" },

    { "type": "header", "content": "Arrows" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show scroll arrows", "default": true, "info": "Arrows appear when there are more products than fit in one row." },
    { "type": "range", "id": "arrow_size", "label": "Arrow size", "min": 28, "max": 56, "step": 4, "unit": "px", "default": 36 },
    { "type": "color", "id": "arrow_background", "label": "Arrow background", "default": "#FFFFFF" },
    { "type": "color", "id": "arrow_icon_color", "label": "Arrow icon", "default": "#111111" },
    { "type": "color", "id": "arrow_border_color", "label": "Arrow border", "default": "#DDDDDD" },

    { "type": "header", "content": "Tabs" },
    { "type": "range", "id": "tab_height", "label": "Tab height", "min": 28, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "tab_padding", "label": "Horizontal padding", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "tab_radius", "label": "Corner radius", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "tab_gap", "label": "Gap", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 4 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#F0F3F5" },
    { "type": "color", "id": "tab_text", "label": "Inactive tab text", "default": "#111111" },
    { "type": "color", "id": "tab_active_background", "label": "Active tab background", "default": "#EEEEEC" },
    { "type": "color", "id": "tab_active_text", "label": "Active tab text", "default": "#111111" },

    { "type": "header", "content": "Spacing" },
    { "type": "paragraph", "content": "Gap = space outside the section, between it and the sections above/below. Padding = space inside, which keeps the section background colour." },
    { "type": "range", "id": "margin_top", "label": "Gap above section", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Gap below section", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_margin_top", "label": "Mobile gap above section", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
